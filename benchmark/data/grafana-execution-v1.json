  "dataset_id": "grafana-routes-v2",
  "comparison_lock_id": "grafana-comparison-targets-v1",
  "solver": {
    "model": "gpt-6.1-sol",
    "reasoning_effort": "medium"
  },
  "grader": {
    "model": "gpt-6-astra",
    "reasoning_effort": "high"
  },
  "repetitions": 1,
  "concurrency": 1,
  "seed": 20260907,
  "limits": {
    "elapsed_seconds": 300,
    "exploration_calls": 80,
    "total_tokens": 500000
  },
  "arm_ids": [
    "codemap-search",
    "codegraph",
    "zvec-grep",
    "graphify",
    "codebase-memory-mcp",
    "rg"
