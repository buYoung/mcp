+#[tokio::test]
+async fn test_grep_output_cap_stops_before_next_region_and_makes_progress() {
+    let line = format!("{} MATCH {}\n", "x".repeat(100), "y".repeat(100));
+    let source = line.repeat(8);
+    let config =
+        "watch = false\n[tool_output]\ngrep_max_columns = 64\ngrep_output_byte_cap = 420\n";
+    let temp =
+        create_mock_repo(&[("capped.rs", &source), (".codemap/config.toml", config)]).unwrap();
+    let mut client = McpClient::spawn(temp.path()).await.unwrap();
+    let first = client
+        .send_request(
+            "tools/call",
+            call(
+                "grep",
+                serde_json::json!({
+                    "pattern": "MATCH",
+                    "path": "capped.rs",
+                    "head_limit": 0
+                }),
+            ),
+        )
+        .await
+        .unwrap();
+    let first_output = text(&first);
+    assert!(
+        first_output.len() <= 420,
+        "{} bytes: {first_output}",
+        first_output.len()
+    );
+    assert!(first_output.contains("next_offset="), "{first_output}");
+    let next_offset: usize = first_output
+        .split("next_offset=")
+        .nth(1)
+        .and_then(|rest| {
+            rest.split(|character: char| !character.is_ascii_digit())
+                .next()
+        })
+        .unwrap()
+        .parse()
+        .unwrap();
+    assert!(next_offset > 0 && next_offset < 8, "{first_output}");
+
+    let next = client
+        .send_request(
+            "tools/call",
+            call(
+                "grep",
+                serde_json::json!({
+                    "pattern": "MATCH",
+                    "path": "capped.rs",
+                    "head_limit": 0,
+                    "offset": next_offset
+                }),
+            ),
+        )
+        .await
+        .unwrap();
+    let next_output = text(&next);
+    assert!(
+        next_output.len() <= 420,
+        "{} bytes: {next_output}",
+        next_output.len()
+    );
+    assert!(
+        next_output.contains(&format!("capped.rs:{}:", next_offset + 1)),
+        "{next_output}"
+    );
+}
