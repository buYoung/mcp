+fn render_match_text(bytes: &[u8], ranges: &[Range<usize>], byte_budget: usize) -> String {
+    let has_line_terminator_match = ranges.iter().any(|range| range.end > bytes.len());
+    if (byte_budget == 0 || bytes.len() <= byte_budget) && !has_line_terminator_match {
+        return String::from_utf8_lossy(bytes).into_owned();
+    }
+    let first = ranges.first().cloned().unwrap_or(0..0);
+    if has_line_terminator_match && (byte_budget == 0 || bytes.len() <= byte_budget) {
+        let location = if first.start == first.end {
+            format!("match byte {}", first.start + 1)
+        } else {
+            format!("match bytes {}-{}", first.start + 1, first.end)
+        };
+        return format!(
+            "{} [{location}; includes line terminator]",
+            String::from_utf8_lossy(bytes)
+        );
+    }
+    let match_length = first.end.saturating_sub(first.start);
+    let mut start = if match_length >= byte_budget {
+        first.start
+    } else {
+        first
+            .start
+            .saturating_sub((byte_budget.saturating_sub(match_length)) / 2)
+    };
+    let mut end = start.saturating_add(byte_budget).min(bytes.len());
+    if end == bytes.len() {
+        start = end.saturating_sub(byte_budget);
+    }
+    start = utf8_floor_boundary(bytes, start);
+    end = utf8_floor_boundary(bytes, start.saturating_add(byte_budget).min(bytes.len()));
+    if end <= start {
+        let location = if first.start == first.end {
+            format!("match byte {}", first.start + 1)
+        } else {
+            format!("match bytes {}-{}", first.start + 1, first.end)
+        };
+        return format!(
+            "[…] [{location}; no complete UTF-8 code point fits the {byte_budget}-byte excerpt; partial match]"
+        );
+    }
+    let location = if first.start == first.end {
+        format!("match byte {}", first.start + 1)
+    } else {
+        format!("match bytes {}-{}", first.start + 1, first.end)
+    };
+    let mut annotations = vec![
+        location,
+        format!("excerpt bytes {}-{end} of {}", start + 1, bytes.len()),
+    ];
+    if has_line_terminator_match {
+        annotations.push("includes line terminator".to_string());
+    }
+    if ranges.len() > 1 {
+        annotations.push(format!("{} additional match(es)", ranges.len() - 1));
+    }
+    if first.start < start || first.end > end {
+        annotations.push("partial match".to_string());
+    }
+    format!(
+        "{}{}{} [{}]",
+        if start > 0 { "[…]" } else { "" },
+        String::from_utf8_lossy(&bytes[start..end]),
+        if end < bytes.len() { "[…]" } else { "" },
