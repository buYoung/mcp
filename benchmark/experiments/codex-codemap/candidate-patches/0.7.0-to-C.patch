+const MONOREPO_OVERVIEW_CAP_FOOTER: &str = "\n\n_Partial overview: reached `overview_output_byte_cap`. Choose a shown scope with `overview <scope>` to set the active search scope; use `workspace_scope: \"all\"` (or `전체`) for the whole repo._\n";
+
+/// Keep the orientation block (title plus totals/scope status) and a useful continuation
+/// footer inside the configured byte cap. Cutting only happens on UTF-8 boundaries and prefers
+/// a complete line. A cap too small for both pieces is a configuration error rather than a
+/// misleading fragment without location or status.
+fn cap_overview_output(text: String, byte_cap: usize) -> Result<String, (i64, String)> {
+    if text.len() <= byte_cap {
+        return Ok(text);
+    }
+
+    let footer = if text.contains("## Workspace Scopes") {
+        MONOREPO_OVERVIEW_CAP_FOOTER
+    } else {
+        OVERVIEW_CAP_FOOTER
+    };
+    let priority_end = overview_priority_prefix_end(&text);
+    let required_bytes = priority_end.saturating_add(footer.len());
+    if required_bytes > byte_cap {
+        return Err((
+            -32603,
+            format!(
+                "Configured overview_output_byte_cap ({byte_cap} bytes) is too small to include the overview location/status and truncation guidance; use at least {required_bytes} bytes for this response"
+            ),
+        ));
+    }
+
+    let content_budget = byte_cap - footer.len();
+    let mut cut = content_budget.min(text.len());
+    while cut > priority_end && !text.is_char_boundary(cut) {
+        cut -= 1;
+    }
+    if let Some(line_end) = text[..cut].rfind('\n') {
+        let complete_line_end = line_end + 1;
+        if complete_line_end >= priority_end {
+            cut = complete_line_end;
+        }
+    }
+
+    let mut output = String::with_capacity(byte_cap);
+    output.push_str(&text[..cut]);
+    output.push_str(footer);
+    debug_assert!(output.len() <= byte_cap);
+    Ok(output)
+}
+
+fn overview_priority_prefix_end(text: &str) -> usize {
+    if let Some(scopes) = text.find("## Workspace Scopes") {
+        let heading_end = end_of_line(text, scopes);
+        return end_of_line(text, heading_end);
+    }
+    if let Some(total_symbols) = text.find("- **Total Symbols**:") {
+        return end_of_line(text, total_symbols);
+    }
+    if let Some(showing) = text.find("> Showing the first ") {
+        return end_of_line(text, showing);
+    }
+    end_of_line(text, 0)
+}
+
+fn end_of_line(text: &str, start: usize) -> usize {
+    text[start..]
+        .find('\n')
+        .map_or(text.len(), |relative| start + relative + 1)
+}
