+fn shrink_context(limits: RenderLimits) -> Option<RenderLimits> {
+    if limits.before == 0 && limits.after == 0 {
+        return None;
+    }
+    let mut next = limits;
+    if next.before >= next.after && next.before > 0 {
+        next.before = next.before.saturating_sub(next.before.max(2) / 2);
+    } else {
+        next.after = next.after.saturating_sub(next.after.max(2) / 2);
+    }
+    Some(next)
+}
