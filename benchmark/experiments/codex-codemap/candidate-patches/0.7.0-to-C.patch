+fn validate_match_excerpt_budget(
+    files: &[FileResult],
+    max_columns: usize,
+) -> Result<(), (i64, String)> {
+    if max_columns == 0 {
+        return Ok(());
+    }
+    for file in files {
+        for region in &file.regions {
+            for match_line in &region.lines {
+                let Some(source) = file.lines.get(&match_line.line_number) else {
+                    continue;
+                };
+                if source.bytes.len() <= max_columns {
+                    continue;
+                }
+                let Some(first_match) = match_line.ranges.first() else {
+                    continue;
+                };
+                if first_match.start >= source.bytes.len() {
+                    continue;
+                }
+                let Ok(tail) = std::str::from_utf8(&source.bytes[first_match.start..]) else {
+                    continue;
+                };
+                let Some(first_character) = tail.chars().next() else {
+                    continue;
+                };
+                let required_bytes = first_character.len_utf8();
+                if required_bytes > max_columns {
+                    return Err((
+                        -32602,
