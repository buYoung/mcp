+fn render_content(
+    files: &[FileResult],
+    selected: &[SelectedRegion],
+    start: usize,
+    total_regions: usize,
+    stats: SearchStats,
+    show_line_numbers: bool,
+) -> String {
+    let mut requested_lines: BTreeMap<(usize, u64), (bool, usize)> = BTreeMap::new();
+    let mut partial_regions = Vec::new();
+    for selection in selected {
+        let selected_region = selection.region;
+        let limits = selection.limits;
+        let file = &files[selected_region.file_index];
+        let region = &file.regions[selected_region.region_index];
+        let shown_match_lines = region.lines.len().min(limits.region_lines);
+        let shown_end_line = region
+            .lines
+            .get(shown_match_lines.saturating_sub(1))
+            .map(|line| line.line_number)
+            .unwrap_or(region.start_line);
+        let context_start = region.start_line.saturating_sub(limits.before as u64);
+        let context_end = shown_end_line.saturating_add(limits.after as u64);
+        for (&line_number, _) in file.lines.range(context_start..=context_end) {
+            let entry = requested_lines
+                .entry((selected_region.file_index, line_number))
+                .or_insert((false, limits.line_bytes));
+            if entry.1 != 0 {
+                entry.1 = if limits.line_bytes == 0 {
+                    0
+                } else {
+                    entry.1.max(limits.line_bytes)
+                };
+            }
+        }
+        for line in region.lines.iter().take(shown_match_lines) {
+            let entry = requested_lines
+                .entry((selected_region.file_index, line.line_number))
+                .or_insert((true, limits.line_bytes));
+            entry.0 = true;
+            if entry.1 != 0 {
+                entry.1 = if limits.line_bytes == 0 {
+                    0
+                } else {
+                    entry.1.max(limits.line_bytes)
+                };
+            }
+        }
+        if shown_match_lines < region.lines.len() {
+            partial_regions.push(format!(
+                "[Partial match region in {}: showing lines {}-{shown_end_line} of original lines {}-{}; source byte offset {}.]",
+                file.path,
+                region.start_line,
+                region.start_line,
+                region.end_line,
+                region.absolute_byte_offset
+            ));
+        }
+        if limits.before < limits.requested_before || limits.after < limits.requested_after {
+            partial_regions.push(format!(
+                "[Context reduced for {}:lines {}-{}: showing up to {} before/{} after of requested {} before/{} after.]",
+                file.path,
+                region.start_line,
+                region.end_line,
+                limits.before,
+                limits.after,
+                limits.requested_before,
+                limits.requested_after
+            ));
+        }
+    }
+
+    let mut output_lines = Vec::new();
+    for ((file_index, line_number), (is_match, line_byte_budget)) in requested_lines {
+        let file = &files[file_index];
+        let Some(source) = file.lines.get(&line_number) else {
+            continue;
+        };
+        let separator = if is_match { ':' } else { '-' };
+        let rendered = if is_match {
+            let ranges: Vec<Range<usize>> = selected
+                .iter()
+                .filter(|selection| selection.region.file_index == file_index)
+                .flat_map(|selection| {
+                    files[file_index].regions[selection.region.region_index]
+                        .lines
+                        .iter()
+                        .filter(move |line| line.line_number == line_number)
+                        .flat_map(|line| line.ranges.clone())
+                })
+                .collect();
+            render_match_text(&source.bytes, &ranges, line_byte_budget)
+        } else {
+            render_context_text(&source.bytes, line_byte_budget)
+        };
+        if show_line_numbers {
+            output_lines.push(format!(
+                "{}{separator}{line_number}{separator}{rendered}",
+                file.path
+            ));
+        } else {
+            output_lines.push(format!("{}{separator}{rendered}", file.path));
+        }
+    }
+    output_lines.extend(partial_regions);
+    output_lines.push(content_status(
+        start,
+        start + selected.len(),
+        total_regions,
+        files.len(),
+        stats,
+    ));
+    output_lines.join("\n")
+}
