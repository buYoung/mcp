+fn render_file_page(
+    files: &[FileResult],
+    offset: usize,
+    head_limit: usize,
+    byte_cap: usize,
+    stats: SearchStats,
+    count_mode: bool,
+) -> Result<String, (i64, String)> {
+    let start = offset.min(files.len());
+    let count_limit = if head_limit == 0 {
+        files.len().saturating_sub(start)
+    } else {
+        head_limit.min(files.len().saturating_sub(start))
+    };
+    let target_end = start.saturating_add(count_limit);
+    let total_occurrences: usize = files.iter().map(|file| file.regions.len()).sum();
+    let render = |end: usize| {
+        let page = &files[start..end];
+        let mut lines = Vec::new();
+        if count_mode {
+            lines.extend(
+                page.iter()
+                    .map(|file| format!("{}:{}", file.path, file.regions.len())),
+            );
+            let page_occurrences: usize = page.iter().map(|file| file.regions.len()).sum();
+            lines.push(format!(
+                "Found {total_occurrences} total occurrence(s) across {} matching file(s); current page: {page_occurrences} occurrence(s) across {} file(s).",
+                files.len(), page.len()
+            ));
+        } else {
+            lines.push(format!("Found {} file(s)", files.len()));
+            lines.extend(page.iter().map(|file| file.path.clone()));
+        }
+        if page.is_empty() && offset > 0 {
+            lines.push(format!(
+                "[No files at offset {offset}; {} total.]",
+                files.len()
+            ));
+        } else if end < files.len() {
+            lines.push(format!(
+                "[Showing files {}-{end} of {}; next_offset={end}. Continue with offset={end} and the same head_limit.]",
+                start + 1,
+                files.len()
+            ));
+        } else if start > 0 {
+            lines.push(format!(
+                "[Showing files {}-{end} of {}; this is the last page.]",
+                start + 1,
+                files.len()
+            ));
+        }
+        lines.push(format!("[Searched {} file(s).]", stats.searched_files));
+        if let Some(partial) = partial_search_status(stats) {
+            lines.push(partial);
+        }
+        lines.join("\n")
+    };
+
+    if count_limit == 0 {
+        let output = render(start);
+        return if output.len() <= byte_cap {
+            Ok(output)
+        } else {
+            Err((
+                -32602,
+                format!(
+                    "grep_output_byte_cap ({byte_cap} bytes) is too small to include result status"
+                ),
+            ))
+        };
+    }
+    let mut end = start;
+    let mut best = String::new();
+    while end < target_end {
+        let candidate = render(end + 1);
+        if candidate.len() > byte_cap {
+            break;
+        }
+        end += 1;
+        best = candidate;
+    }
+    if end == start {
+        return Err((
+            -32602,
+            format!(
+                "grep_output_byte_cap ({byte_cap} bytes) is too small to include the first file location and status"
+            ),
+        ));
+    }
+    Ok(best)
+}
