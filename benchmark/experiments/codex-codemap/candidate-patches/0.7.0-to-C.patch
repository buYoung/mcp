+#[tokio::test]
+async fn test_grep_read_failure_marks_partial_results() {
+    use std::os::unix::fs::PermissionsExt;
+
+    let temp = create_mock_repo(&[("good.rs", "MATCH\n"), ("blocked.rs", "MATCH\n")]).unwrap();
+    let blocked = temp.path().join("blocked.rs");
+    let original_permissions = std::fs::metadata(&blocked).unwrap().permissions();
+    std::fs::set_permissions(&blocked, std::fs::Permissions::from_mode(0o000)).unwrap();
+
+    let mut client = McpClient::spawn(temp.path()).await.unwrap();
+    let response = client
+        .send_request(
+            "tools/call",
+            call("grep", serde_json::json!({ "pattern": "MATCH" })),
+        )
+        .await
+        .unwrap();
+    std::fs::set_permissions(&blocked, original_permissions).unwrap();
+
+    let output = text(&response);
+    assert!(output.contains("good.rs:1:MATCH"), "{output}");
+    assert!(output.contains("Partial search"), "{output}");
+    assert!(output.contains("1 file read error(s)"), "{output}");
