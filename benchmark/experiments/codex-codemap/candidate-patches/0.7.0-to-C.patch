+#[allow(clippy::too_many_arguments)]
+fn render_content_page(
+    files: &[FileResult],
+    regions: &[RegionRef],
+    offset: usize,
+    head_limit: usize,
+    stats: SearchStats,
+    show_line_numbers: bool,
+    before: usize,
+    after: usize,
+    max_columns: usize,
+    byte_cap: usize,
+) -> Result<String, (i64, String)> {
+    let start = offset.min(regions.len());
+    let count_limit = if head_limit == 0 {
+        regions.len().saturating_sub(start)
+    } else {
+        head_limit.min(regions.len().saturating_sub(start))
+    };
+    if count_limit == 0 {
+        let mut output = format!(
+            "[No match regions at offset {offset}; {} total.]\n[Searched {} file(s).]",
+            regions.len(),
+            stats.searched_files
+        );
+        if let Some(partial) = partial_search_status(stats) {
+            output.push('\n');
+            output.push_str(&partial);
+        }
+        return if output.len() <= byte_cap {
+            Ok(output)
+        } else {
+            Err((
+                -32602,
+                format!(
+                    "grep_output_byte_cap ({byte_cap} bytes) is too small to include result status"
+                ),
+            ))
+        };
+    }
+
+    let first = regions[start];
+    let first_region_lines = files[first.file_index].regions[first.region_index]
+        .lines
+        .len()
+        .max(1);
+    let initial_limits = RenderLimits {
+        before,
+        after,
+        requested_before: before,
+        requested_after: after,
+        line_bytes: max_columns,
+        region_lines: first_region_lines,
+    };
+    let (mut best, limits) = render_first_region_within_cap(
+        files,
+        first,
+        start,
+        regions.len(),
+        stats,
+        show_line_numbers,
+        initial_limits,
+        byte_cap,
+    )?;
+    let mut selected = vec![SelectedRegion {
+        region: first,
+        limits,
+    }];
+    for region in regions
+        .iter()
+        .skip(start + 1)
+        .take(count_limit.saturating_sub(1))
+    {
+        let mut candidate = selected.clone();
+        let region_line_count = files[region.file_index].regions[region.region_index]
+            .lines
+            .len()
+            .max(1);
+        candidate.push(SelectedRegion {
+            region: *region,
+            limits: RenderLimits {
+                before,
+                after,
+                requested_before: before,
+                requested_after: after,
+                line_bytes: max_columns,
+                region_lines: region_line_count,
+            },
+        });
+        let output = render_content(
+            files,
+            &candidate,
+            start,
+            regions.len(),
+            stats,
+            show_line_numbers,
+        );
+        if output.len() > byte_cap {
+            break;
+        }
+        selected = candidate;
+        best = output;
+    }
+    Ok(best)
+}
