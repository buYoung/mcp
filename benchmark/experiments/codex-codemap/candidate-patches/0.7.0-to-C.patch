+fn render_first_region_within_cap(
+    files: &[FileResult],
+    selected: RegionRef,
+    start: usize,
+    total_regions: usize,
+    stats: SearchStats,
+    show_line_numbers: bool,
+    initial_limits: RenderLimits,
+    byte_cap: usize,
+) -> Result<(String, RenderLimits), (i64, String)> {
+    let mut limits = initial_limits;
+    loop {
+        let output = render_content(
+            files,
+            &[SelectedRegion {
+                region: selected,
+                limits,
+            }],
+            start,
+            total_regions,
+            stats,
+            show_line_numbers,
+        );
+        if output.len() <= byte_cap {
+            return Ok((output, limits));
+        }
+        if let Some(smaller) = shrink_context(limits) {
+            limits = smaller;
+            continue;
+        }
+        if limits.line_bytes == 0 {
+            limits.line_bytes = files[selected.file_index]
+                .lines
+                .values()
+                .map(|line| line.bytes.len())
+                .max()
+                .unwrap_or(MIN_EXCERPT_BYTES);
+        }
+        if limits.line_bytes > MIN_EXCERPT_BYTES {
+            limits.line_bytes = (limits.line_bytes / 2).max(MIN_EXCERPT_BYTES);
+            continue;
+        }
+        if limits.region_lines > 1 {
+            limits.region_lines = (limits.region_lines / 2).max(1);
+            continue;
+        }
+        return Err((
+            -32602,
+            format!(
+                "grep_output_byte_cap ({byte_cap} bytes) is too small to include the first match location, excerpt, and continuation status"
+            ),
+        ));
+    }
+}
