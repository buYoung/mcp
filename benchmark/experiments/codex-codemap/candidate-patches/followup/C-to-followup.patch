--- /dev/null
+++ b/apps/codemap-search/src/tools/search/import_candidates.rs
@@ -0,0 +1,271 @@
+//! Name-only import observations, appended after all existing search output.
+use std::cmp::Reverse;
+use std::collections::BTreeSet;
+
+use crate::{index::{is_test_like_path, NamedImportIndex}, parser::{CodeRange, QueryTokens, split_identifier}};
+
+const MAX_BYTES: usize = 1536;
+const MAX_GROUPS: usize = 2;
+const MAX_FILES: usize = 4;
+const HEADER: &str = "\n\n## Observed named import candidates\n_Name match only: same declaration and actual consumption are not confirmed. Read source to verify._\n";
+
+struct CandidateGroup {
+    title: String,
+    rows: Vec<String>,
+    file_count: usize,
+    is_query_name: bool,
+    query_token_hits: usize,
+}
+
+impl CandidateGroup {
+    fn text(&self, shown_files: usize) -> String {
+        format!("{}{}  - Showing {} of {} files (first import per shown file).\n",
+            self.title, self.rows[..shown_files].concat(), shown_files, self.file_count)
+    }
+}
+
+pub(super) fn render(
+    displayed_types: &[(String, String, CodeRange)],
+    index: &NamedImportIndex,
+    workspace_scope: Option<&str>,
+    query: &QueryTokens,
+    available_bytes: usize,
+) -> String {
+    let byte_cap = available_bytes.min(MAX_BYTES);
+    if byte_cap <= HEADER.len() { return String::new(); }
+    let in_scope = |path: &str| workspace_scope.is_none_or(|scope| super::monorepo::path_is_under_scope(path, scope));
+    let mut seen_names = BTreeSet::new();
+    let mut groups = Vec::new();
+    let mut total_files = 0usize;
+    for (path, name, range) in displayed_types {
+        if !in_scope(path) || !seen_names.insert(name.as_str()) { continue; }
+        let Some(records) = index.by_name.get(name) else { continue };
+        let mut scoped_records: Vec<_> = records.iter().filter(|record| in_scope(&record.file_path)).collect();
+        let file_count = scoped_records.iter().map(|record| &record.file_path).collect::<BTreeSet<_>>().len();
+        if file_count == 0 { continue; }
+        total_files += file_count;
+        // Keep test imports available for follow-up, but do not let their lexical
+        // path order displace implementation code. The normal search score is untouched.
+        scoped_records.sort_by_cached_key(|record| {
+            let context_hits = index.implementation_tokens.get(&record.file_path).map_or(0,
+                |tokens| tokens.iter().filter(|token| query.contains_token(token)).count());
+            (is_test_like_path(&record.file_path), Reverse(context_hits))
+        });
+        let declaration_count = index.declarations_by_name.get(name).map_or(0, |declarations|
+            declarations.iter().filter(|(path, _)| in_scope(path)).count());
+        let ambiguity = if declaration_count > 1 {
+            format!("; ambiguous: {declaration_count} same-name declarations in scope")
+        } else { String::new() };
+        let title = format!("- `{name}` displayed at {path}:{}; {file_count} candidate files / {} import observations{ambiguity}\n", range.start_line, scoped_records.len());
+        let mut seen_files = BTreeSet::new();
+        let mut rows = Vec::new();
+        for record in scoped_records {
+            if !seen_files.insert(record.file_path.as_str()) { continue; }
+            let import = &record.import;
+            let source = serde_json::to_string(import.source.as_deref().unwrap_or("")).unwrap();
+            let alias = serde_json::to_string(&import.local_name).unwrap();
+            let offset = import.range.start_line;
+            let limit = import.range.end_line - offset + 1;
+            let row = format!("  - {}:{}:{} module={source}; local={alias}; read offset={offset} limit={limit}\n", record.file_path, offset, import.range.start_col);
+            // A huge single import must not hide the next readable observation.
+            if HEADER.len() + title.len() + row.len() <= byte_cap { rows.push(row); }
+            if rows.len() >= MAX_FILES { break; }
+        }
+        let name_tokens = split_identifier(name);
+        groups.push(CandidateGroup { title, rows, file_count,
+            is_query_name: query.contains_word(&name.to_lowercase()),
+            query_token_hits: name_tokens.iter().filter(|token| query.contains_token(token)).count(),
+        });
+    }
+    if groups.is_empty() { return String::new(); }
+    // Stable ordering keeps the original displayed declaration order for equal matches.
+    groups.sort_by_key(|group| (Reverse(group.is_query_name), Reverse(group.query_token_hits)));
+    let scope = serde_json::to_string(workspace_scope.unwrap_or(".")).unwrap();
+    let footer = format!("- Total: {total_files} candidate files across {} names (per-name counts). Order: queried names, non-test paths, matching type context. Exact `grep` with `fixed_strings=true`, `pattern=<type name>`, `path={scope}`; follow `next_offset` and verify use in source.\n", groups.len());
+    let mut used_bytes = HEADER.len() + footer.len();
+    let mut selected = Vec::new();
+    // Reserve a first row for each group before any group can consume all remaining
+    // bytes. This is solely an optional suffix; primary source/call output has priority.
+    for group in &groups {
+        if selected.len() >= MAX_GROUPS { break; }
+        if group.rows.is_empty() { continue; }
+        let first_bytes = group.text(1).len();
+        if used_bytes + first_bytes <= byte_cap {
+            used_bytes += first_bytes;
+            selected.push((group, 1usize));
+        }
+    }
+    if selected.is_empty() { return String::new(); }
+    loop {
+        let mut has_added_file = false;
+        for (group, shown_files) in &mut selected {
+            if *shown_files == group.rows.len() { continue; }
+            let added_bytes = group.text(*shown_files + 1).len() - group.text(*shown_files).len();
+            if used_bytes + added_bytes <= byte_cap {
+                *shown_files += 1;
+                used_bytes += added_bytes;
+                has_added_file = true;
+            }
+        }
+        if !has_added_file { break; }
+    }
+    let mut text = HEADER.to_string();
+    for (group, shown_files) in selected { text.push_str(&group.text(shown_files)); }
+    text.push_str(&footer);
+    text
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::{index::PublishedIndexSnapshot, parser::ExtractedFile};
+
+    fn file(path: &str, declaration: Option<(&str, &str)>, imports: serde_json::Value) -> ExtractedFile {
+        let symbols = declaration.map(|(name, kind)| serde_json::json!([{
+            "name": name, "kind": kind, "range": range_json(), "docstring": null,
+            "flags": {"hasTodo":false,"hasFixme":false,"isTest":false,"isExported":false,"isDeprecated":false}
+        }])).unwrap_or_else(|| serde_json::json!([]));
+        serde_json::from_value(serde_json::json!({
+            "filePath":path,"totalLines":10,"symbols":symbols,"literals":[],"docstrings":[],
+            "navigation": if imports.is_null() { serde_json::Value::Null } else { serde_json::json!({"imports":imports}) }
+        })).unwrap()
+    }
+    fn range_json() -> serde_json::Value {
+        serde_json::json!({"startLine":2,"startCol":1,"endLine":3,"endCol":20})
+    }
+    fn import(name: &str, local: &str, kind: &str) -> serde_json::Value {
+        serde_json::json!({"localName":local,"importedName":name,"source":"./model","kind":kind,"range":range_json()})
+    }
+    fn display(path: &str, name: &str) -> (String, String, CodeRange) {
+        (path.into(),name.into(),serde_json::from_value(range_json()).unwrap())
+    }
+    fn snapshot(files: Vec<ExtractedFile>) -> PublishedIndexSnapshot {
+        PublishedIndexSnapshot::from_files_and_edges(files.into_iter().map(|file| (file, vec![])).collect())
