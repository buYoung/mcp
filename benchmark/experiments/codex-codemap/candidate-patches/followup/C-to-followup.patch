@@ -0,0 +1,74 @@
+//! Derived, in-memory navigation data. Never persisted or used for ranking.
+use std::collections::{BTreeMap, BTreeSet};
+
+use crate::parser::{CodeRange, ExtractedFile, ImportEntry, ImportKind, split_identifier};
+
+pub(crate) fn is_type_declaration(kind: &str) -> bool {
+    matches!(kind, "class" | "struct" | "interface" | "record" | "object" | "enum" | "union" | "type" | "trait")
+}
+
+#[derive(Debug, Clone)]
+pub(crate) struct NamedImportRecord {
+    pub file_path: String,
+    pub import: ImportEntry,
+}
+
+#[derive(Debug, Clone, Default)]
+pub(crate) struct NamedImportIndex {
+    pub by_name: BTreeMap<String, Vec<NamedImportRecord>>,
+    pub implementation_tokens: BTreeMap<String, BTreeSet<String>>,
+    pub declarations_by_name: BTreeMap<String, Vec<(String, CodeRange)>>,
+}
+
+impl NamedImportIndex {
+    pub fn from_files(files: &[ExtractedFile]) -> Self {
+        let mut index = Self::default();
+        let mut seen_imports = BTreeSet::new();
+        let mut seen_declarations = BTreeSet::new();
+        for file in files {
+            for symbol in &file.symbols {
+                let range = &symbol.range;
+                if is_type_declaration(&symbol.kind) && seen_declarations.insert((
+                    file.file_path.clone(), symbol.name.clone(), range.start_line,
+                    range.start_col, range.end_line, range.end_col,
+                )) {
+                    index.declarations_by_name.entry(symbol.name.clone()).or_default()
+                        .push((file.file_path.clone(), range.clone()));
+                }
+            }
+            let Some(navigation) = &file.navigation else { continue };
+            // Context is only a hint for ordering observed imports. It does not resolve
+            // their module or prove that a reference consumes the displayed declaration.
+            let mut context_tokens = BTreeSet::new();
+            for symbol in file.symbols.iter().filter(|symbol| {
+                matches!(symbol.kind.as_str(), "class" | "struct" | "object" | "record" | "enum" | "union")
+            }) {
+                context_tokens.insert(symbol.name.to_lowercase());
+                context_tokens.extend(split_identifier(&symbol.name));
+            }
+            if !context_tokens.is_empty() {
+                index.implementation_tokens.insert(file.file_path.clone(), context_tokens);
+            }
+            for import in &navigation.imports {
+                if import.kind != ImportKind::Named { continue; }
+                let (Some(name), Some(source)) = (&import.imported_name, &import.source) else { continue };
+                if name.is_empty() || name == "*" || name == "default" || source.is_empty() { continue; }
+                let range = &import.range;
+                if range.start_line == 0 || range.end_line < range.start_line { continue; }
+                if !seen_imports.insert((file.file_path.clone(), name.clone(), source.clone(),
+                    import.local_name.clone(), range.start_line, range.start_col,
+                    range.end_line, range.end_col)) { continue; }
+                index.by_name.entry(name.clone()).or_default().push(NamedImportRecord {
+                    file_path: file.file_path.clone(), import: import.clone(),
+                });
+            }
+        }
+        for records in index.by_name.values_mut() {
+            records.sort_by(|left, right| left.file_path.cmp(&right.file_path)
+                .then(left.import.range.start_line.cmp(&right.import.range.start_line))
+                .then(left.import.range.start_col.cmp(&right.import.range.start_col))
+                .then(left.import.local_name.cmp(&right.import.local_name)));
+        }
+        index
+    }
+}
