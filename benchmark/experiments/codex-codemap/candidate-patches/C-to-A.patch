+
+#[tokio::test]
+async fn test_search_owner_is_rendered_with_original_symbol_and_source() {
+    let temp = create_mock_repo(&[("src/lib.rs", "pub struct Channel;\nimpl Channel {\n pub fn dispatch(&self) {}\n}\n")]).unwrap();
+    let mut client = crate::e2e::helpers::McpClient::spawn(temp.path()).await.unwrap();
+    let response = client.send_request("tools/call", serde_json::json!({
+        "name":"search", "arguments":{"query":"dispatch", "caller_context":false}
+    })).await.unwrap();
+    let text = response["result"]["content"][0]["text"].as_str().unwrap();
+    assert!(text.contains("Symbol: dispatch (fn) [L3-3]; owner: Channel"), "{text}");
+    assert!(text.contains("3→ pub fn dispatch(&self) {}"), "{text}");
+}
