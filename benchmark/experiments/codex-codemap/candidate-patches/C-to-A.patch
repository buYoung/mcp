+mod evidence_guidance_tests {
+    #[test]
+    fn test_owner_suffix_preserves_symbol_identity() {
+        let symbol: crate::parser::ExtractedSymbol = serde_json::from_value(serde_json::json!({
+            "name":"apply", "kind":"method", "owner":"Channel",
+            "range":{"startLine":3,"startCol":0,"endLine":7,"endCol":1},
+            "docstring":null,
+            "flags":{"hasTodo":false,"hasFixme":false,"isTest":false,"isExported":false,"isDeprecated":false}
+        })).unwrap();
+        assert_eq!(super::symbol_owner_suffix(&symbol), "; owner: Channel");
+        let mut ownerless = symbol.clone();
+        ownerless.owner = None;
+        assert_eq!(super::symbol_owner_suffix(&ownerless), "");
+        assert_eq!((symbol.name.as_str(), symbol.kind.as_str(), symbol.range.start_line, symbol.range.end_line), ("apply", "method", 3, 7));
