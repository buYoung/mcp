{
    "name": "buyong-mcp",
    "private": true,
    "scripts": {
        "bench:ready": "python3 -m benchmark.codex.ready",
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "biome check .",
        "format": "biome check --write .",
        "check-types": "turbo run check-types",
        "prepare": "husky",
        "release": "node scripts/release/release.mjs",
        "docs:pages:create": "pnpm --filter @buyong-mcp/codemap-docs run pages:create",
        "docs:deploy": "pnpm --filter @buyong-mcp/codemap-docs run deploy",
        "bench:start": "node benchmark/codex/start.mjs"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.15",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "release-it": "^20.2.1",
        "semver": "7.7.4",
        "turbo": "^2.11.7",
        "typescript": "6.0.3",
        "@inquirer/prompts": "8.4.2"
    },
    "packageManager": "pnpm@11.1.1",
    "engines": {
        "node": ">=18"
    }
}
