        }

        private render() {
            const state = this.readStateFromForm();

            // 1. Build syntax-colored TOML & mark modified setting rows
            const { lines: tomlLines, modifiedKeys } = this.buildToml(state);
            const tomlOut = this.querySelector<HTMLElement>("[data-toml-out]");
            if (tomlOut) this.renderHighlightedToml(tomlOut, tomlLines);

            for (const row of Array.from(this.querySelectorAll<HTMLElement>(".wb-row[data-setting]"))) {
                const k = row.dataset.setting ?? "";
                row.classList.toggle("is-modified", modifiedKeys.has(k));
            }

            // 2. Compute outputs & diffs
            const currentOutputs = this.computeOutputs(state);
            const changedSet = new Set<string>();

            for (const item of currentOutputs) {
                const base = this.baselineOutputs.get(item.id);
                if (!base) continue;
                const pChanged = JSON.stringify(base.params) !== JSON.stringify(item.params);
                if (pChanged || base.lines.join("\n") !== item.lines.join("\n")) {
                    changedSet.add(item.id);
                }
            }

            // Telemetry pill in top bar
            const telemetry = this.querySelector<HTMLElement>("[data-telemetry]");
            if (telemetry) {
                if (modifiedKeys.size === 0) {
                    telemetry.textContent = this.ui.defaultBadge ?? "All defaults";
                    telemetry.classList.remove("is-active");
                } else {
                    telemetry.textContent = (this.ui.statusFmt ?? "{m} modified · {t}/7 tools")
                        .replace("{m}", String(modifiedKeys.size))
                        .replace("{t}", String(changedSet.size));
                    telemetry.classList.add("is-active");
                }
            }

            // Update tool tab dots & label
            for (const tab of Array.from(this.querySelectorAll<HTMLButtonElement>("[data-tool-tab]"))) {
                const tid = tab.dataset.toolTab ?? "";
                if (tid !== "all") tab.classList.toggle("has-diff", changedSet.has(tid));
            }
            const allLabel = this.querySelector<HTMLElement>("[data-all-tab-label]");
            if (allLabel) {
                allLabel.textContent =
                    changedSet.size > 0
                        ? this.locale === "ko"
                            ? `전체 (${changedSet.size}/7)`
                            : `All (${changedSet.size}/7)`
                        : (this.ui.tabAll ?? "All 7");
            }

            // 3. Render Inspector Stream
            const panel = this.querySelector<HTMLElement>("[data-outputs-panel]");
            if (!panel) return;
            panel.replaceChildren();

            const visibleTools = currentOutputs.filter((item) => {
                if (this.selectedTab !== "all") return item.id === this.selectedTab;
                if (this.changedToolsOnly) return changedSet.has(item.id);
                return true;
            });

            if (visibleTools.length === 0) {
                const empty = document.createElement("p");
                empty.className = "wb-empty-msg";
                empty.textContent = this.ui.noChangedTools ?? "";
                panel.append(empty);
                return;
            }

            const enc = new TextEncoder();
            for (const item of visibleTools) {
                const base = this.baselineOutputs.get(item.id);
                const isChanged = changedSet.has(item.id);
                const baseLineSet = new Set(base ? base.lines : []);

                const curBytes = enc.encode(item.lines.join("\n")).length;
                const baseBytes = base ? enc.encode(base.lines.join("\n")).length : curBytes;
                const delta = curBytes - baseBytes;

                const card = document.createElement("article");
                card.className = `wb-panel${isChanged ? " is-changed" : ""}`;

                // Header strip
                const hdr = document.createElement("header");
                hdr.className = "wb-panel-hdr";

                const leftHdr = document.createElement("div");
                leftHdr.className = "wb-panel-left";

                const toolName = document.createElement("code");
                toolName.className = "wb-tool-name";
                toolName.textContent = item.id;
                leftHdr.append(toolName);

                const paramList = document.createElement("div");
                paramList.className = "wb-params";
                if (item.params.length === 0) {
                    const pChip = document.createElement("code");
                    pChip.className = "wb-param";
                    pChip.textContent = "{}";
                    paramList.append(pChip);
                } else {
                    for (const [pk, pv] of item.params) {
                        const pChip = document.createElement("code");
                        pChip.className = "wb-param";
                        pChip.textContent = `${pk}=${pv}`;
                        paramList.append(pChip);
                    }
                }
                leftHdr.append(paramList);

                const rightHdr = document.createElement("div");
                rightHdr.className = "wb-panel-right";

                if (delta !== 0) {
                    const deltaEl = document.createElement("span");
                    deltaEl.className = `wb-delta ${delta < 0 ? "is-saved" : "is-added"}`;
                    deltaEl.textContent = delta < 0 ? `${delta} B` : `+${delta} B`;
                    rightHdr.append(deltaEl);
                }

                const bytesEl = document.createElement("span");
                bytesEl.className = "wb-bytes";
                bytesEl.textContent = `${curBytes.toLocaleString()} B`;
                rightHdr.append(bytesEl);

                const stateEl = document.createElement("span");
                stateEl.className = `wb-badge${isChanged ? " is-changed" : ""}`;
                stateEl.textContent = isChanged
                    ? (this.ui.modifiedBadge ?? "Modified")
                    : (this.ui.unchangedBadge ?? "Default");
                rightHdr.append(stateEl);

                hdr.append(leftHdr, rightHdr);

                // Output / Diff code block
                const pre = document.createElement("pre");
                pre.className = "wb-code";
                pre.tabIndex = 0;

                const code = document.createElement("code");
                if (this.viewMode === "diff" && base && isChanged) {
                    const diffRows = computeLineDiff(base.lines, item.lines);
                    for (const dr of diffRows) {
                        const rowEl = document.createElement("span");
                        rowEl.className =
                            dr.kind === "del"
                                ? "wb-line is-del"
                                : dr.kind === "add"
                                  ? "wb-line is-add"
                                  : "wb-line";

                        const numEl = document.createElement("span");
                        numEl.className = "wb-gutter";
                        numEl.setAttribute("aria-hidden", "true");
                        numEl.textContent = dr.lineNo;

                        const sigEl = document.createElement("span");
                        sigEl.className = "wb-sig";
                        sigEl.setAttribute("aria-hidden", "true");
                        sigEl.textContent = dr.kind === "del" ? "-" : dr.kind === "add" ? "+" : " ";

                        const txtEl = document.createElement("span");
                        txtEl.className = "wb-txt";
                        txtEl.textContent = dr.text || " ";

                        rowEl.append(numEl, sigEl, txtEl);
                        code.append(rowEl);
                    }
                } else {
                    item.lines.forEach((ln, idx) => {
                        const isLineChanged = isChanged && ln.trim() !== "" && !baseLineSet.has(ln);
                        const rowEl = document.createElement("span");
                        rowEl.className = isLineChanged ? "wb-line is-mod" : "wb-line";

                        const numEl = document.createElement("span");
                        numEl.className = "wb-gutter";
                        numEl.setAttribute("aria-hidden", "true");
                        numEl.textContent = String(idx + 1);

                        const txtEl = document.createElement("span");
                        txtEl.className = "wb-txt";
                        txtEl.textContent = ln || " ";

                        rowEl.append(numEl, txtEl);
                        code.append(rowEl);
                    });
                }

                pre.append(code);
                card.append(hdr, pre);
                panel.append(card);
            }
        }
    }

    if (!customElements.get("codemap-config-playground")) {
        customElements.define("codemap-config-playground", CodemapConfigPlayground);
    }
</script>
