            }

            const outLines: string[] = [];
            sections.forEach(([hdr, lns], idx) => {
                if (idx > 0) outLines.push("");
                outLines.push(hdr);
                outLines.push(...lns);
            });
            return { lines: outLines, modifiedKeys: mod };
        }

        private renderHighlightedToml(target: HTMLElement, lines: string[]) {
            target.replaceChildren();
            lines.forEach((ln, idx) => {
                const row = document.createElement("span");
                row.className = "wb-toml-line";

                const num = document.createElement("span");
                num.className = "wb-gutter";
                num.setAttribute("aria-hidden", "true");
                num.textContent = String(idx + 1);
                row.append(num);

                const body = document.createElement("span");
                body.className = "wb-toml-code";

                if (ln.startsWith("#")) {
                    const c = document.createElement("span");
                    c.className = "tk-cmt";
                    c.textContent = ln;
                    body.append(c);
                } else if (ln.startsWith("[")) {
                    const s = document.createElement("span");
                    s.className = "tk-sec";
                    s.textContent = ln;
                    body.append(s);
                } else if (ln.includes(" = ")) {
                    const eqIdx = ln.indexOf(" = ");
                    const kSpan = document.createElement("span");
                    kSpan.className = "tk-key";
                    kSpan.textContent = ln.slice(0, eqIdx);

                    const opSpan = document.createElement("span");
                    opSpan.textContent = " = ";

                    const rest = ln.slice(eqIdx + 3);
                    const cmtIdx = rest.indexOf(" #");
                    const valPart = cmtIdx >= 0 ? rest.slice(0, cmtIdx) : rest;
                    const cmtPart = cmtIdx >= 0 ? rest.slice(cmtIdx) : "";

                    const vSpan = document.createElement("span");
                    vSpan.className = "tk-val";
                    vSpan.textContent = valPart;

                    body.append(kSpan, opSpan, vSpan);
                    if (cmtPart) {
                        const cm = document.createElement("span");
                        cm.className = "tk-cmt";
                        cm.textContent = cmtPart;
                        body.append(cm);
                    }
                } else {
                    body.textContent = ln || " ";
                }

                row.append(body);
                target.append(row);
            });
        }

        private maskValue(
            s: PgState,
            kind: "secret" | "shortSecret" | "urlPass" | "sensWebhook" | "glsa" | "email" | "ip" | "rrn" | "card",
            raw: string,
        ): string {
            if (!s.redactEnabled) return raw;
            if (kind === "secret") return "[REDACTED]";
            if (kind === "shortSecret") return "*".repeat(raw.length);
            if (kind === "urlPass") return "********";
            if (kind === "sensWebhook") return s.sensWebhook ? "[REDACTED]" : raw;
            if (kind === "glsa") return s.customRule ? "glsa_[REDACTED]" : raw;
            if (kind === "email") return s.piiEntities.includes("EMAIL_ADDRESS") ? "[REDACTED]" : raw;
            if (kind === "ip") return s.piiEntities.includes("IP_ADDRESS") ? "[REDACTED]" : raw;
            if (kind === "rrn") return s.piiEntities.includes("KR_RRN") ? "[REDACTED]" : raw;
            if (kind === "card") return s.piiEntities.includes("CREDIT_CARD") ? "[REDACTED]" : raw;
            return raw;
        }

