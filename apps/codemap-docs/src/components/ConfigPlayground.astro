                } else if (!s.includeSeen) {
                    searchLines.push("- `method DashboardServiceImpl.DeleteDashboard` (L210-226): `<--removed duplicated-->`");
                } else {
                    searchLines.push("210→func (dr *DashboardServiceImpl) DeleteDashboard(ctx context.Context, dashboardId int64, orgId int64) error {");
                    searchLines.push("211→    return dr.store.DeleteDashboard(ctx, &dashboards.DeleteDashboardCommand{ID: dashboardId, OrgID: orgId})");
                    searchLines.push("212→}");
                }

                // File 2: mailer.go (detailed if detailFileLimit >= 2, else compact tail)
                const extraCandidates: Array<{ path: string; detail: string[] }> = [
                    {
                        path: "pkg/services/notifications/mailer.go",
                        detail:
                            s.jevEnabled && s.jevScope.includes("search")
                                ? [
                                      "## 2. pkg/services/notifications/mailer.go",
                                      `- _omitted body: L38-46 (method WebhookSender.SendWebhook) Jev (${s.jevModel}) found no task match in pkg/services/notifications/mailer.go._`,
