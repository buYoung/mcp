        private render() {
            const state = this.readStateFromForm();

            // 1. Update live TOML & modified count badge
            const { text: tomlText, modifiedCount } = this.buildToml(state);
            const tomlOut = this.querySelector<HTMLElement>("[data-toml-out]");
            if (tomlOut) tomlOut.textContent = tomlText;

            const modBadge = this.querySelector<HTMLElement>("[data-mod-count]");
            if (modBadge) {
                if (modifiedCount === 0) {
                    modBadge.textContent = this.ui.defaultBadge ?? "Defaults";
                    modBadge.classList.remove("is-modified");
                } else {
                    modBadge.textContent = (this.ui.changedCountFmt ?? "{n} modified").replace(
                        "{n}",
                        String(modifiedCount),
                    );
                    modBadge.classList.add("is-modified");
                }
            }

            // 2. Compute all 7 tool outputs & compare against baseline
            const currentOutputs = this.computeOutputs(state);
            const changedSet = new Set<string>();

            for (const item of currentOutputs) {
                const base = this.baselineOutputs.get(item.id);
                if (!base) continue;
                if (base.callJson !== item.callJson || base.lines.join("\n") !== item.lines.join("\n")) {
                    changedSet.add(item.id);
                }
            }

            // Update tab indicators
            for (const tab of Array.from(this.querySelectorAll<HTMLButtonElement>("[data-tool-tab]"))) {
                const tid = tab.dataset.toolTab ?? "";
                if (tid !== "all") {
                    tab.classList.toggle("has-diff", changedSet.has(tid));
                }
            }
            const allLabel = this.querySelector<HTMLElement>("[data-all-tab-label]");
            if (allLabel) {
                if (changedSet.size > 0) {
                    allLabel.textContent =
                        this.locale === "ko"
                            ? `전체 (${changedSet.size}/7 변경)`
                            : `All (${changedSet.size}/7 changed)`;
                } else {
                    allLabel.textContent = this.ui.tabAll ?? "All (7)";
                }
            }

            // 3. Render tool output cards
            const panel = this.querySelector<HTMLElement>("[data-outputs-panel]");
            if (!panel) return;
            panel.replaceChildren();

            const visibleTools = currentOutputs.filter((item) => {
                if (this.selectedTab !== "all") return item.id === this.selectedTab;
                if (this.changedToolsOnly) return changedSet.has(item.id);
                return true;
            });

            if (visibleTools.length === 0) {
                const empty = document.createElement("p");
                empty.className = "pg-empty-msg";
                empty.textContent = this.ui.noChangedTools ?? "";
                panel.append(empty);
                return;
            }

            const enc = new TextEncoder();
            for (const item of visibleTools) {
                const base = this.baselineOutputs.get(item.id);
                const isChanged = changedSet.has(item.id);
                const baseLineSet = new Set(base ? base.lines : []);

                const curBytes = enc.encode(item.lines.join("\n")).length;
                const baseBytes = base ? enc.encode(base.lines.join("\n")).length : curBytes;
                const delta = curBytes - baseBytes;

                const card = document.createElement("article");
                card.className = `pg-tool-card${isChanged ? " is-changed" : ""}`;

                const hdr = document.createElement("header");
                hdr.className = "pg-tool-hdr";

                const nameWrap = document.createElement("div");
                nameWrap.className = "pg-tool-name-wrap";

                const toolCode = document.createElement("code");
                toolCode.className = "pg-tool-name";
                toolCode.textContent = item.id;

                const statusBadge = document.createElement("span");
                statusBadge.className = `pg-tool-badge${isChanged ? " is-changed" : ""}`;
                statusBadge.textContent = isChanged
                    ? (this.ui.modifiedBadge ?? "Modified")
                    : (this.ui.unchangedBadge ?? "Default");

                nameWrap.append(toolCode, statusBadge);

                const byteMeta = document.createElement("span");
                byteMeta.className = "pg-byte-meta";
                const deltaStr =
                    delta === 0 ? "" : delta > 0 ? ` (+${delta} B)` : ` (${delta} B)`;
                byteMeta.textContent = `${curBytes.toLocaleString()} B${deltaStr}`;

                hdr.append(nameWrap, byteMeta);

                const callRow = document.createElement("div");
                callRow.className = "pg-call-row";
                const callTag = document.createElement("span");
                callTag.className = "pg-call-tag";
                callTag.textContent = this.ui.reqLabel ?? "Call";
                const callCode = document.createElement("code");
                callCode.className = `pg-call-code${base && base.callJson !== item.callJson && this.highlightDiff ? " is-changed-line" : ""}`;
                callCode.textContent = item.callJson;
                callRow.append(callTag, callCode);

                const pre = document.createElement("pre");
                pre.className = "pg-out-pre";
                pre.tabIndex = 0;

                const code = document.createElement("code");
                for (const ln of item.lines) {
                    const lineSpan = document.createElement("span");
                    const lineDiff = this.highlightDiff && isChanged && ln.trim() !== "" && !baseLineSet.has(ln);
                    lineSpan.className = lineDiff ? "pg-out-line is-changed-line" : "pg-out-line";
                    lineSpan.textContent = ln === "" ? " " : ln;
                    code.append(lineSpan);
                }
                pre.append(code);

                card.append(hdr, callRow, pre);
                panel.append(card);
            }
        }
    }

    if (!customElements.get("codemap-config-playground")) {
        customElements.define("codemap-config-playground", CodemapConfigPlayground);
    }
</script>
