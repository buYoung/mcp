---
interface Props {
    locale: "en" | "ko";
}

const { locale } = Astro.props;
const isKo = locale === "ko";

const ui = {
    presetsLabel: isKo ? "빠른 프리셋" : "Presets",
    presetDefault: isKo ? "기본값" : "Defaults",
    presetPrecise: isKo ? "정밀 호출·참조" : "Precise calls & refs",
    presetJev: isKo ? "Jev·토큰 절약" : "Jev & compact",
    presetSecurity: isKo ? "보안·PII 강화" : "Strict PII & scope",
    presetBroad: isKo ? "테스트·문서 포함" : "Tests & docs",
    resetBtn: isKo ? "초기화" : "Reset",
    tomlTitle: ".codemap/config.toml",
    tomlChangedOnly: isKo ? "변경 키만" : "Modified only",
    tomlFull: isKo ? "전체 키" : "Full config",
    copyToml: isKo ? "설정 복사" : "Copy config",
    copiedMsg: isKo ? "복사됨" : "Copied",
    copyFailedMsg: isKo ? "복사 실패" : "Copy failed",
    defaultBadge: isKo ? "기본값" : "Defaults",
    changedCountFmt: isKo ? "변경 {n}개" : "{n} modified",
    groupContext: isKo ? "호출·이벤트 문맥" : "Call & Event Context",
    groupLimits: isKo ? "도구별 출력·접기" : "Output Limits & Folding",
    groupRedact: isKo ? "인증정보·PII 마스킹" : "Credential & PII Masking",
    groupJev: isKo ? "Jev 작업 관련성 필터" : "Jev Relevance Filter",
    groupIndex: isKo ? "색인·권한·확장 도구" : "Index, Permissions & Extras",
    lblContextEnabled: isKo ? "search 기본 호출 관계 표시" : "Show callers/callees in search",
    lblNavPrecise: isKo ? "구조·import 정밀 확인 (precise)" : "Structural import check (precise)",
    lblCallerLimit: isKo ? "심볼당 최대 호출자 수" : "Max callers per symbol",
    lblIncludeTests: isKo ? "호출 문맥에 테스트 코드 포함" : "Include test files in callers",
    lblEvents: isKo ? "정적 이벤트 발행·구독 경로" : "Static event publish/subscribe routes",
    lblDetailFiles: isKo ? "상세 발췌 상위 파일 수" : "Detailed snippet file limit",
    lblSnippetLines: isKo ? "심볼당 최대 발췌 줄 수" : "Max snippet lines per symbol",
    lblOutsideCallers: isKo ? "read 범위 밖 호출자·import 표시" : "Append outside callers in read",
    lblGrepCols: isKo ? "grep 줄 길이 상한 (0=무제한)" : "grep max line width (0=unlimited)",
    lblIncludeSeen: isKo ? "중복 구간 재출력 (호출 인자)" : "Re-print seen lines (call arg)",
    lblRedactMaster: isKo ? "인증정보·선택 PII 마스킹" : "Mask credentials & selected PII",
    lblPiiEntities: isKo ? "추가 PII 유형" : "Opt-in PII types",
    lblSensField: isKo ? "민감 필드 추가 (webhookSigningKey)" : "Extra field (webhookSigningKey)",
    lblCustomRule: isKo ? "사용자 정규식 (glsa_ 토큰)" : "Custom regex (glsa_ token)",
    lblJevEnabled: isKo ? "Jev 판정 필터 활성화" : "Enable Jev decision filter",
    lblJevScope: isKo ? "적용 도구 범위" : "Filtered tools",
    lblJevModel: isKo ? "판정 모델" : "Decision model",
    lblIndexMode: isKo ? "색인 실행 모드" : "Indexing mode",
    lblStoreRefs: isKo ? "비호출 심볼 참조 위치도 색인" : "Index non-call references",
    lblExcludedDirs: isKo ? "디렉터리 제외 목록" : "Directory exclusions",
    optDirsDefault: isKo ? "기본 목록 (build, vendor 등)" : "Defaults (build, vendor…)",
    optDirsEmpty: isKo ? "[] (선택 제외 해제)" : "[] (none)",
    lblDocSupport: isKo ? "Markdown (.md/.mdx) 색인 포함" : "Index Markdown (.md/.mdx)",
    lblPerms: isKo ? "파일 접근 범위 (find/grep/read)" : "Filesystem scope (find/grep/read)",
    lblSynonyms: isKo ? "synonyms 유의어 도구 활성화" : "Enable synonyms tool",
    lblGlobalInst: isKo ? "클라이언트 전역 지침 자동 관리" : "Manage client global instructions",
    outHeader: isKo ? "grafana/grafana 도구 출력" : "grafana/grafana Tool Output",
    tabAll: isKo ? "전체 (7)" : "All (7)",
    highlightDiff: isKo ? "변경 줄 강조" : "Highlight changed lines",
    changedToolsOnly: isKo ? "변경된 도구만" : "Changed tools only",
    unchangedBadge: isKo ? "기본 출력" : "Default",
    modifiedBadge: isKo ? "변경됨" : "Modified",
    noChangedTools: isKo
        ? "현재 기본 설정과 동일합니다. 왼쪽 설정을 바꾸면 영향을 받는 도구가 여기에 표시됩니다."
        : "All outputs currently match the defaults. Change a setting on the left to see affected tools here.",
    reqLabel: isKo ? "호출" : "Call",
};

const clientPayload = JSON.stringify({ locale, ui });
---

<codemap-config-playground class="pg-root not-content" data-pg={clientPayload}>
    <div class="pg-PresetBar" role="toolbar" aria-label={ui.presetsLabel}>
        <span class="pg-preset-caption">{ui.presetsLabel}</span>
        <button type="button" class="pg-preset-btn is-active" data-preset="default">{ui.presetDefault}</button>
        <button type="button" class="pg-preset-btn" data-preset="precise">{ui.presetPrecise}</button>
        <button type="button" class="pg-preset-btn" data-preset="jev">{ui.presetJev}</button>
        <button type="button" class="pg-preset-btn" data-preset="security">{ui.presetSecurity}</button>
        <button type="button" class="pg-preset-btn" data-preset="broad">{ui.presetBroad}</button>
        <button type="button" class="pg-reset-btn" data-reset>{ui.resetBtn}</button>
    </div>

    <div class="pg-split">
        <!-- LEFT PANE: Configuration Controls + Live config.toml -->
        <div class="pg-left">
            <div class="pg-toml-card">
                <div class="pg-toml-header">
                    <div class="pg-toml-title-wrap">
                        <code class="pg-toml-filename">{ui.tomlTitle}</code>
                        <span class="pg-mod-badge" data-mod-count>{ui.defaultBadge}</span>
                    </div>
                    <div class="pg-toml-actions">
                        <div class="pg-seg" role="group" aria-label="TOML mode">
                            <button type="button" class="pg-seg-btn" data-toml-mode="diff" aria-pressed="true">
                                {ui.tomlChangedOnly}
                            </button>
                            <button type="button" class="pg-seg-btn" data-toml-mode="full" aria-pressed="false">
                                {ui.tomlFull}
                            </button>
                        </div>
                        <span class="pg-copy-wrap">
                            <button
                                type="button"
                                class="pg-copy-btn"
                                command="--copy"
                                commandfor="pg-toml-code"
                            >
                                <span class="pg-copy-icon" aria-hidden="true"></span>
                                <span>{ui.copyToml}</span>
                            </button>
                            <span class="pg-copy-tip" role="status"></span>
                        </span>
                    </div>
                </div>
                <pre class="pg-toml-pre" tabindex="0" role="region" aria-label={ui.tomlTitle}><code id="pg-toml-code" data-toml-out></code></pre>
            </div>

            <form class="pg-form" data-pg-form>
                <!-- 1. Call & Event Context -->
                <fieldset class="pg-fieldset">
                    <legend>{ui.groupContext}</legend>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-ctx-enabled" name="contextEnabled" checked />
                        <label for="pg-ctx-enabled">
                            <code>[output.context].is_enabled</code>
                            <span>{ui.lblContextEnabled}</span>
                        </label>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-nav-precise" name="navPrecise" />
                        <label for="pg-nav-precise">
                            <code>[output.navigation].is_enabled</code>
                            <span>{ui.lblNavPrecise}</span>
                        </label>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-caller-limit">
                            <code>[output.context].caller_limit</code>
                            <span>{ui.lblCallerLimit}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-caller-limit">
                            <label class="pg-pill"><input type="radio" name="callerLimit" value="1000" checked /><span>1000</span></label>
                            <label class="pg-pill"><input type="radio" name="callerLimit" value="2" /><span>2</span></label>
                            <label class="pg-pill"><input type="radio" name="callerLimit" value="1" /><span>1</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-inc-tests" name="includeTests" />
                        <label for="pg-inc-tests">
                            <code>[output.context.exclude].should_include_test_code</code>
                            <span>{ui.lblIncludeTests}</span>
                        </label>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-events" name="eventsEnabled" checked />
                        <label for="pg-events">
                            <code>[output.event_navigation].is_enabled</code>
                            <span>{ui.lblEvents}</span>
                        </label>
                    </div>
                </fieldset>

                <!-- 2. Per-tool Output Limits & Folding -->
                <fieldset class="pg-fieldset">
                    <legend>{ui.groupLimits}</legend>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-detail-files">
                            <code>[output.search].detail_file_limit</code>
                            <span>{ui.lblDetailFiles}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-detail-files">
                            <label class="pg-pill"><input type="radio" name="detailFileLimit" value="24" checked /><span>24</span></label>
                            <label class="pg-pill"><input type="radio" name="detailFileLimit" value="2" /><span>2</span></label>
                            <label class="pg-pill"><input type="radio" name="detailFileLimit" value="1" /><span>1</span></label>
                        </div>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-snippet-lines">
                            <code>[output.search].snippet_max_lines</code>
                            <span>{ui.lblSnippetLines}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-snippet-lines">
                            <label class="pg-pill"><input type="radio" name="snippetMaxLines" value="500" checked /><span>500</span></label>
                            <label class="pg-pill"><input type="radio" name="snippetMaxLines" value="6" /><span>6</span></label>
                            <label class="pg-pill"><input type="radio" name="snippetMaxLines" value="3" /><span>3</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-outside-callers" name="outsideCallers" checked />
                        <label for="pg-outside-callers">
                            <code>[output.read].is_outside_callers_enabled</code>
                            <span>{ui.lblOutsideCallers}</span>
                        </label>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-grep-cols">
                            <code>[output.grep].max_columns</code>
                            <span>{ui.lblGrepCols}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-grep-cols">
                            <label class="pg-pill"><input type="radio" name="grepMaxColumns" value="0" checked /><span>0</span></label>
                            <label class="pg-pill"><input type="radio" name="grepMaxColumns" value="90" /><span>90</span></label>
                            <label class="pg-pill"><input type="radio" name="grepMaxColumns" value="60" /><span>60</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-inc-seen" name="includeSeen" />
                        <label for="pg-inc-seen">
                            <code>include_seen</code>
                            <span>{ui.lblIncludeSeen}</span>
                        </label>
                    </div>
                </fieldset>

                <!-- 3. Credential & PII Masking -->
                <fieldset class="pg-fieldset">
                    <legend>{ui.groupRedact}</legend>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-redact-master" name="redactEnabled" checked />
                        <label for="pg-redact-master">
                            <code>[output].is_redact_enabled</code>
                            <span>{ui.lblRedactMaster}</span>
                        </label>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-pii-entities">
                            <code>[output.redact].pii_entities</code>
                            <span>{ui.lblPiiEntities}</span>
                        </span>
                        <div class="pg-check-pills" role="group" aria-labelledby="lbl-pii-entities">
                            <label class="pg-pill"><input type="checkbox" name="pii_EMAIL_ADDRESS" /><span>EMAIL_ADDRESS</span></label>
                            <label class="pg-pill"><input type="checkbox" name="pii_IP_ADDRESS" /><span>IP_ADDRESS</span></label>
                            <label class="pg-pill"><input type="checkbox" name="pii_KR_RRN" /><span>KR_RRN</span></label>
                            <label class="pg-pill"><input type="checkbox" name="pii_CREDIT_CARD" /><span>CREDIT_CARD</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-sens-field" name="sensWebhook" />
                        <label for="pg-sens-field">
                            <code>[output.redact].sensitive_fields</code>
                            <span>{ui.lblSensField}</span>
                        </label>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-custom-rule" name="customRule" />
                        <label for="pg-custom-rule">
                            <code>[output.redact].rules</code>
                            <span>{ui.lblCustomRule}</span>
                        </label>
                    </div>
                </fieldset>

                <!-- 4. Jev Filter -->
                <fieldset class="pg-fieldset">
                    <legend>{ui.groupJev}</legend>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-jev-enabled" name="jevEnabled" />
                        <label for="pg-jev-enabled">
                            <code>[output.jev].enabled</code>
                            <span>{ui.lblJevEnabled}</span>
                        </label>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-jev-scope">
                            <code>[output.jev].scope</code>
                            <span>{ui.lblJevScope}</span>
                        </span>
                        <div class="pg-check-pills" role="group" aria-labelledby="lbl-jev-scope">
                            <label class="pg-pill"><input type="checkbox" name="jev_search" checked /><span>search</span></label>
                            <label class="pg-pill"><input type="checkbox" name="jev_read" checked /><span>read</span></label>
                            <label class="pg-pill"><input type="checkbox" name="jev_grep" checked /><span>grep</span></label>
                        </div>
                    </div>

                    <div class="pg-row-select">
                        <label for="pg-jev-model">
                            <code>[output.jev].model</code>
                            <span>{ui.lblJevModel}</span>
                        </label>
                        <select id="pg-jev-model" name="jevModel">
                            <option value="jev-1.14.0">jev-1.14.0</option>
                            <option value="openai/gpt-6-luna-decisions">openai/gpt-6-luna-decisions</option>
                            <option value="perplexity/pplx-decider-flash-v1.2">perplexity/pplx-decider-flash-v1.2</option>
                        </select>
                    </div>
                </fieldset>

                <!-- 5. Index, Permissions & Extra Tools -->
                <fieldset class="pg-fieldset">
                    <legend>{ui.groupIndex}</legend>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-index-mode">
                            <code>[index].mode</code>
                            <span>{ui.lblIndexMode}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-index-mode">
                            <label class="pg-pill"><input type="radio" name="indexMode" value="auto" checked /><span>"auto"</span></label>
                            <label class="pg-pill"><input type="radio" name="indexMode" value="on" /><span>"on"</span></label>
                            <label class="pg-pill"><input type="radio" name="indexMode" value="off" /><span>"off"</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-store-refs" name="storeRefs" />
                        <label for="pg-store-refs">
                            <code>[index].store_references</code>
                            <span>{ui.lblStoreRefs}</span>
                        </label>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-excl-dirs">
                            <code>[index.exclude].excluded_directories</code>
                            <span>{ui.lblExcludedDirs}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-excl-dirs">
                            <label class="pg-pill"><input type="radio" name="exclDirs" value="default" checked /><span>{ui.optDirsDefault}</span></label>
                            <label class="pg-pill"><input type="radio" name="exclDirs" value="empty" /><span>{ui.optDirsEmpty}</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-doc-support" name="docSupport" />
                        <label for="pg-doc-support">
                            <code>[index.language_support].is_document_support_enabled</code>
                            <span>{ui.lblDocSupport}</span>
                        </label>
                    </div>

                    <div class="pg-row-radios">
                        <span class="pg-field-label" id="lbl-perms">
                            <code>[filesystem_permissions].*</code>
                            <span>{ui.lblPerms}</span>
                        </span>
                        <div class="pg-radio-pills" role="radiogroup" aria-labelledby="lbl-perms">
                            <label class="pg-pill"><input type="radio" name="fsPerm" value="anywhere" checked /><span>"anywhere"</span></label>
                            <label class="pg-pill"><input type="radio" name="fsPerm" value="workspace" /><span>"workspace"</span></label>
                            <label class="pg-pill"><input type="radio" name="fsPerm" value="allowed_roots" /><span>"allowed_roots"</span></label>
                        </div>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-synonyms" name="synonymsEnabled" />
                        <label for="pg-synonyms">
                            <code>[related_terms].enabled</code>
                            <span>{ui.lblSynonyms}</span>
                        </label>
                    </div>

                    <div class="pg-row-check">
                        <input type="checkbox" id="pg-global-inst" name="globalInst" />
                        <label for="pg-global-inst">
                            <code>[global_instructions].enabled</code>
                            <span>{ui.lblGlobalInst}</span>
                        </label>
                    </div>
                </fieldset>
            </form>
        </div>

        <!-- RIGHT PANE: Real-Time Outputs Across All 7 Tools on grafana/grafana -->
        <div class="pg-right">
            <div class="pg-right-head">
                <div class="pg-right-top">
                    <strong class="pg-right-title">{ui.outHeader}</strong>
                    <div class="pg-view-opts">
                        <label class="pg-mini-check">
                            <input type="checkbox" data-highlight-diff checked />
                            <span>{ui.highlightDiff}</span>
                        </label>
                        <label class="pg-mini-check">
                            <input type="checkbox" data-changed-only />
                            <span>{ui.changedToolsOnly}</span>
                        </label>
                    </div>
                </div>

                <div class="pg-tablist" role="tablist" aria-label={ui.outHeader}>
                    <button type="button" role="tab" aria-selected="true" data-tool-tab="all">
                        <span data-all-tab-label>{ui.tabAll}</span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="search">
                        <span>search</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="read">
                        <span>read</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="grep">
                        <span>grep</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="find">
                        <span>find</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="initial_instructions">
                        <span>initial_instructions</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="analyze">
                        <span>analyze</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="synonyms">
                        <span>synonyms</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                </div>
            </div>

            <div class="pg-outputs" role="tabpanel" aria-label={ui.outHeader} data-outputs-panel></div>
        </div>
    </div>
</codemap-config-playground>

<script>
    interface PgState {
        contextEnabled: boolean;
        navPrecise: boolean;
        callerLimit: number;
        includeTests: boolean;
        eventsEnabled: boolean;
        detailFileLimit: number;
        snippetMaxLines: number;
        outsideCallers: boolean;
        grepMaxColumns: number;
        includeSeen: boolean;
        redactEnabled: boolean;
        piiEntities: string[];
        sensWebhook: boolean;
        customRule: boolean;
        jevEnabled: boolean;
        jevScope: string[];
        jevModel: string;
        indexMode: "auto" | "on" | "off";
        storeRefs: boolean;
        exclDirs: "default" | "empty";
        docSupport: boolean;
        fsPerm: "anywhere" | "workspace" | "allowed_roots";
        synonymsEnabled: boolean;
        globalInst: boolean;
    }

    interface ToolRender {
        id: string;
        callJson: string;
        lines: string[];
    }

    const DEFAULT_STATE: PgState = {
        contextEnabled: true,
        navPrecise: false,
        callerLimit: 1000,
        includeTests: false,
        eventsEnabled: true,
        detailFileLimit: 24,
        snippetMaxLines: 500,
        outsideCallers: true,
        grepMaxColumns: 0,
        includeSeen: false,
        redactEnabled: true,
        piiEntities: [],
        sensWebhook: false,
        customRule: false,
        jevEnabled: false,
        jevScope: ["search", "read", "grep"],
        jevModel: "jev-1.14.0",
        indexMode: "auto",
        storeRefs: false,
        exclDirs: "default",
        docSupport: false,
        fsPerm: "anywhere",
        synonymsEnabled: false,
        globalInst: false,
    };

    const PRESETS: Record<string, Partial<PgState>> = {
        default: {},
        precise: {
            navPrecise: true,
            storeRefs: true,
            synonymsEnabled: true,
        },
        jev: {
            jevEnabled: true,
            detailFileLimit: 1,
            snippetMaxLines: 6,
            grepMaxColumns: 90,
        },
        security: {
            redactEnabled: true,
            piiEntities: ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN", "CREDIT_CARD"],
            sensWebhook: true,
            customRule: true,
            fsPerm: "workspace",
        },
        broad: {
            includeTests: true,
            docSupport: true,
            exclDirs: "empty",
            includeSeen: true,
        },
    };

    const copyTimers = new WeakMap<HTMLElement, number>();
    let lastStatusText = "";

    function legacyCopy(text: string): boolean {
        const field = Object.assign(document.createElement("textarea"), { value: text });
        field.setAttribute("readonly", "");
        field.style.cssText = "position:fixed;inset-block-start:0;opacity:0";
        document.body.append(field);
        field.select();
        try {
            return document.execCommand("copy");
        } finally {
            field.remove();
        }
    }

    class CodemapConfigPlayground extends HTMLElement {
        private locale: "en" | "ko" = "ko";
        private ui: Record<string, string> = {};
        private tomlMode: "diff" | "full" = "diff";
        private selectedTab = "all";
        private highlightDiff = true;
        private changedToolsOnly = false;
        private baselineOutputs: Map<string, ToolRender> = new Map();

        connectedCallback() {
            const raw = this.dataset.pg;
            if (!raw) return;
            const parsed = JSON.parse(raw) as { locale: "en" | "ko"; ui: Record<string, string> };
            this.locale = parsed.locale;
            this.ui = parsed.ui;

            for (const item of this.computeOutputs(DEFAULT_STATE)) {
                this.baselineOutputs.set(item.id, item);
            }

            this.wireControls();
            this.wireCopyButton();
            this.render();
        }

        private readStateFromForm(): PgState {
            const form = this.querySelector<HTMLFormElement>("[data-pg-form]");
            if (!form) return { ...DEFAULT_STATE };
            const fd = new FormData(form);

            const piiEntities: string[] = [];
            for (const ent of ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN", "CREDIT_CARD"]) {
                if (fd.has(`pii_${ent}`)) piiEntities.push(ent);
            }

            const jevScope: string[] = [];
            for (const sc of ["search", "read", "grep"]) {
                if (fd.has(`jev_${sc}`)) jevScope.push(sc);
            }

            return {
                contextEnabled: fd.has("contextEnabled"),
                navPrecise: fd.has("navPrecise"),
                callerLimit: Number(fd.get("callerLimit") ?? 1000),
                includeTests: fd.has("includeTests"),
                eventsEnabled: fd.has("eventsEnabled"),
                detailFileLimit: Number(fd.get("detailFileLimit") ?? 24),
                snippetMaxLines: Number(fd.get("snippetMaxLines") ?? 500),
                outsideCallers: fd.has("outsideCallers"),
                grepMaxColumns: Number(fd.get("grepMaxColumns") ?? 0),
                includeSeen: fd.has("includeSeen"),
                redactEnabled: fd.has("redactEnabled"),
                piiEntities,
                sensWebhook: fd.has("sensWebhook"),
                customRule: fd.has("customRule"),
                jevEnabled: fd.has("jevEnabled"),
                jevScope,
                jevModel: String(fd.get("jevModel") ?? "jev-1.14.0"),
                indexMode: (fd.get("indexMode") as PgState["indexMode"]) ?? "auto",
                storeRefs: fd.has("storeRefs"),
                exclDirs: (fd.get("exclDirs") as PgState["exclDirs"]) ?? "default",
                docSupport: fd.has("docSupport"),
                fsPerm: (fd.get("fsPerm") as PgState["fsPerm"]) ?? "anywhere",
                synonymsEnabled: fd.has("synonymsEnabled"),
                globalInst: fd.has("globalInst"),
            };
        }

        private applyStateToForm(state: PgState) {
            const form = this.querySelector<HTMLFormElement>("[data-pg-form]");
            if (!form) return;

            const setCheck = (name: string, val: boolean) => {
                const el = form.elements.namedItem(name) as HTMLInputElement | null;
                if (el) el.checked = val;
            };
            const setRadio = (name: string, val: string) => {
                const list = form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
                for (const r of list) r.checked = r.value === val;
            };

            setCheck("contextEnabled", state.contextEnabled);
            setCheck("navPrecise", state.navPrecise);
            setRadio("callerLimit", String(state.callerLimit));
            setCheck("includeTests", state.includeTests);
            setCheck("eventsEnabled", state.eventsEnabled);
            setRadio("detailFileLimit", String(state.detailFileLimit));
            setRadio("snippetMaxLines", String(state.snippetMaxLines));
            setCheck("outsideCallers", state.outsideCallers);
            setRadio("grepMaxColumns", String(state.grepMaxColumns));
            setCheck("includeSeen", state.includeSeen);
            setCheck("redactEnabled", state.redactEnabled);
            for (const ent of ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN", "CREDIT_CARD"]) {
                setCheck(`pii_${ent}`, state.piiEntities.includes(ent));
            }
            setCheck("sensWebhook", state.sensWebhook);
            setCheck("customRule", state.customRule);
            setCheck("jevEnabled", state.jevEnabled);
            for (const sc of ["search", "read", "grep"]) {
                setCheck(`jev_${sc}`, state.jevScope.includes(sc));
            }
            const modelSel = form.elements.namedItem("jevModel") as HTMLSelectElement | null;
            if (modelSel) modelSel.value = state.jevModel;
            setRadio("indexMode", state.indexMode);
            setCheck("storeRefs", state.storeRefs);
            setRadio("exclDirs", state.exclDirs);
            setCheck("docSupport", state.docSupport);
            setRadio("fsPerm", state.fsPerm);
            setCheck("synonymsEnabled", state.synonymsEnabled);
            setCheck("globalInst", state.globalInst);
        }

        private wireControls() {
            const form = this.querySelector<HTMLFormElement>("[data-pg-form]");
            form?.addEventListener("input", () => {
                this.clearActivePreset();
                this.render();
            });
            form?.addEventListener("change", () => {
                this.clearActivePreset();
                this.render();
            });
            form?.addEventListener("submit", (e) => e.preventDefault());

            const presetBtns = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-preset]"));
            for (const btn of presetBtns) {
                btn.addEventListener("click", () => {
                    const key = btn.dataset.preset ?? "default";
                    const next: PgState = {
                        ...DEFAULT_STATE,
                        piiEntities: [...DEFAULT_STATE.piiEntities],
                        jevScope: [...DEFAULT_STATE.jevScope],
                        ...(PRESETS[key] ?? {}),
                    };
                    this.applyStateToForm(next);
                    for (const b of presetBtns) b.classList.toggle("is-active", b === btn);
                    this.render();
                });
            }

            this.querySelector<HTMLButtonElement>("[data-reset]")?.addEventListener("click", () => {
                this.applyStateToForm({
                    ...DEFAULT_STATE,
                    piiEntities: [],
                    jevScope: ["search", "read", "grep"],
                });
                for (const b of presetBtns) b.classList.toggle("is-active", b.dataset.preset === "default");
                this.render();
            });

            const modeBtns = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-toml-mode]"));
            for (const btn of modeBtns) {
                btn.addEventListener("click", () => {
                    this.tomlMode = (btn.dataset.tomlMode as "diff" | "full") ?? "diff";
                    for (const b of modeBtns) {
                        b.setAttribute("aria-pressed", String(b === btn));
                    }
                    this.render();
                });
            }

            const diffToggle = this.querySelector<HTMLInputElement>("[data-highlight-diff]");
            diffToggle?.addEventListener("change", () => {
                this.highlightDiff = diffToggle.checked;
                this.render();
            });

            const changedOnlyToggle = this.querySelector<HTMLInputElement>("[data-changed-only]");
            changedOnlyToggle?.addEventListener("change", () => {
                this.changedToolsOnly = changedOnlyToggle.checked;
                this.render();
            });

            const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-tool-tab]"));
            const selectTab = (targetBtn: HTMLButtonElement, moveFocus: boolean) => {
                this.selectedTab = targetBtn.dataset.toolTab ?? "all";
                for (const t of tabs) {
                    const active = t === targetBtn;
                    t.setAttribute("aria-selected", String(active));
                    t.tabIndex = active ? 0 : -1;
                }
                if (moveFocus) {
                    targetBtn.focus();
                    targetBtn.scrollIntoView({ block: "nearest", inline: "nearest" });
                }
                this.render();
            };

            for (const tab of tabs) {
                tab.addEventListener("click", () => selectTab(tab, false));
                tab.addEventListener("keydown", (e) => {
                    const idx = tabs.indexOf(tab);
                    if (e.key === "ArrowRight") {
                        e.preventDefault();
                        selectTab(tabs[(idx + 1) % tabs.length], true);
                    } else if (e.key === "ArrowLeft") {
                        e.preventDefault();
                        selectTab(tabs[(idx - 1 + tabs.length) % tabs.length], true);
                    } else if (e.key === "Home") {
                        e.preventDefault();
                        selectTab(tabs[0], true);
                    } else if (e.key === "End") {
                        e.preventDefault();
                        selectTab(tabs[tabs.length - 1], true);
                    }
                });
            }
        }

        private clearActivePreset() {
            for (const b of Array.from(this.querySelectorAll<HTMLButtonElement>("[data-preset]"))) {
                b.classList.remove("is-active");
            }
        }

        private wireCopyButton() {
            const btn = this.querySelector<HTMLButtonElement>(".pg-copy-btn");
            const codeEl = this.querySelector<HTMLElement>("[data-toml-out]");
            if (!btn || !codeEl) return;

            const doCopy = async () => {
                const text = (codeEl.innerText || codeEl.textContent || "").trim();
                if (!text) return;
                let ok = true;
                try {
                    await navigator.clipboard.writeText(text);
                } catch {
                    ok = legacyCopy(text);
                }
                this.reportCopy(btn, ok);
            };

            if ("CommandEvent" in window) {
                document.addEventListener(
                    "command",
                    (event: Event) => {
                        const ce = event as Event & { command?: string; source?: Element };
                        if (ce.command === "--copy" && ce.source === btn) {
                            void doCopy();
                        }
                    },
                    true,
                );
            } else {
                btn.addEventListener("click", () => {
                    void doCopy();
                });
            }
        }

        private reportCopy(button: HTMLButtonElement, ok: boolean) {
            const tip = button.nextElementSibling as HTMLElement | null;
            if (!tip) return;
            const prevTimer = copyTimers.get(button);
            if (prevTimer) window.clearTimeout(prevTimer);

            button.removeAttribute("data-copied");
            button.removeAttribute("data-failed");
            let message = ok ? (this.ui.copiedMsg ?? "Copied") : (this.ui.copyFailedMsg ?? "Copy failed");
            if (message === lastStatusText) message += "\u00A0";
            lastStatusText = message;

            tip.textContent = "";
            void button.offsetWidth;
            button.setAttribute(ok ? "data-copied" : "data-failed", "");
            requestAnimationFrame(() => {
                tip.textContent = message;
            });
            const timer = window.setTimeout(() => {
                button.removeAttribute("data-copied");
                button.removeAttribute("data-failed");
                tip.textContent = "";
            }, 2000);
            copyTimers.set(button, timer);
        }

        private buildToml(s: PgState): { text: string; modifiedCount: number } {
            const full = this.tomlMode === "full";
            const sections: Array<[string, string[]]> = [];
            let mod = 0;

            const push = (sec: string, lines: string[]) => {
                if (lines.length > 0) sections.push([sec, lines]);
            };

            // [global_instructions]
            if (s.globalInst !== DEFAULT_STATE.globalInst) mod++;
            if (full || s.globalInst !== DEFAULT_STATE.globalInst) {
                const note =
                    this.locale === "ko"
                        ? " # 전역 ~/.codemap/config.toml 전용"
                        : " # global ~/.codemap/config.toml only";
                push("[global_instructions]", [`enabled = ${s.globalInst}${note}`]);
            }

            // [output]
            if (s.redactEnabled !== DEFAULT_STATE.redactEnabled) mod++;
            if (full || s.redactEnabled !== DEFAULT_STATE.redactEnabled) {
                push("[output]", [`is_redact_enabled = ${s.redactEnabled}`]);
            }

            // [output.search]
            const searchLines: string[] = [];
            if (s.detailFileLimit !== DEFAULT_STATE.detailFileLimit) mod++;
            if (full || s.detailFileLimit !== DEFAULT_STATE.detailFileLimit) {
                searchLines.push(`detail_file_limit = ${s.detailFileLimit}`);
            }
            if (s.snippetMaxLines !== DEFAULT_STATE.snippetMaxLines) mod++;
            if (full || s.snippetMaxLines !== DEFAULT_STATE.snippetMaxLines) {
                searchLines.push(`snippet_max_lines = ${s.snippetMaxLines}`);
            }
            push("[output.search]", searchLines);

            // [output.read]
            if (s.outsideCallers !== DEFAULT_STATE.outsideCallers) mod++;
            if (full || s.outsideCallers !== DEFAULT_STATE.outsideCallers) {
                push("[output.read]", [`is_outside_callers_enabled = ${s.outsideCallers}`]);
            }

            // [output.grep]
            if (s.grepMaxColumns !== DEFAULT_STATE.grepMaxColumns) mod++;
            if (full || s.grepMaxColumns !== DEFAULT_STATE.grepMaxColumns) {
                push("[output.grep]", [`max_columns = ${s.grepMaxColumns}`]);
            }

            // [output.context]
            const ctxLines: string[] = [];
            if (s.contextEnabled !== DEFAULT_STATE.contextEnabled) mod++;
            if (full || s.contextEnabled !== DEFAULT_STATE.contextEnabled) {
                ctxLines.push(`is_enabled = ${s.contextEnabled}`);
            }
            if (s.callerLimit !== DEFAULT_STATE.callerLimit) mod++;
            if (full || s.callerLimit !== DEFAULT_STATE.callerLimit) {
                ctxLines.push(`caller_limit = ${s.callerLimit}`);
            }
            push("[output.context]", ctxLines);

            // [output.context.exclude]
            if (s.includeTests !== DEFAULT_STATE.includeTests) mod++;
            if (full || s.includeTests !== DEFAULT_STATE.includeTests) {
                push("[output.context.exclude]", [`should_include_test_code = ${s.includeTests}`]);
            }

            // [output.navigation]
            if (s.navPrecise !== DEFAULT_STATE.navPrecise) mod++;
            if (full || s.navPrecise !== DEFAULT_STATE.navPrecise) {
                push("[output.navigation]", [`is_enabled = ${s.navPrecise}`]);
            }

            // [output.event_navigation]
            if (s.eventsEnabled !== DEFAULT_STATE.eventsEnabled) mod++;
            if (full || s.eventsEnabled !== DEFAULT_STATE.eventsEnabled) {
                push("[output.event_navigation]", [`is_enabled = ${s.eventsEnabled}`]);
            }

            // [output.redact]
            const redactLines: string[] = [];
            if (s.piiEntities.length > 0) mod++;
            if (full || s.piiEntities.length > 0) {
                const arr = s.piiEntities.map((x) => `"${x}"`).join(", ");
                redactLines.push(`pii_entities = [${arr}]`);
            }
            if (s.sensWebhook) mod++;
            if (full || s.sensWebhook) {
                redactLines.push(`sensitive_fields = [${s.sensWebhook ? '"webhookSigningKey"' : ""}]`);
            }
            if (s.customRule) mod++;
            if (full || s.customRule) {
                redactLines.push(
                    s.customRule
                        ? `rules = [{ id = "custom.service-token", pattern = 'glsa_(?P<secret>[A-Za-z0-9_]{16,})' }]`
                        : "rules = []",
                );
            }
            push("[output.redact]", redactLines);

            // [output.jev]
            const jevLines: string[] = [];
            const defaultScopeStr = DEFAULT_STATE.jevScope.join(",");
            const curScopeStr = s.jevScope.join(",");
            if (s.jevEnabled !== DEFAULT_STATE.jevEnabled) mod++;
            if (curScopeStr !== defaultScopeStr) mod++;
            if (s.jevModel !== DEFAULT_STATE.jevModel) mod++;
            if (full || s.jevEnabled || curScopeStr !== defaultScopeStr || s.jevModel !== DEFAULT_STATE.jevModel) {
                jevLines.push(`enabled = ${s.jevEnabled}`);
                const scArr = s.jevScope.map((x) => `"${x}"`).join(", ");
                jevLines.push(`scope = [${scArr}]`);
                jevLines.push(`model = "${s.jevModel}"`);
            }
            push("[output.jev]", jevLines);

            // [index]
            const idxLines: string[] = [];
            if (s.indexMode !== DEFAULT_STATE.indexMode) mod++;
            if (full || s.indexMode !== DEFAULT_STATE.indexMode) {
                idxLines.push(`mode = "${s.indexMode}"`);
            }
            if (s.storeRefs !== DEFAULT_STATE.storeRefs) mod++;
            if (full || s.storeRefs !== DEFAULT_STATE.storeRefs) {
                idxLines.push(`store_references = ${s.storeRefs}`);
            }
            push("[index]", idxLines);

            // [index.exclude]
            if (s.exclDirs !== DEFAULT_STATE.exclDirs) mod++;
            if (full || s.exclDirs !== DEFAULT_STATE.exclDirs) {
                push("[index.exclude]", [
                    s.exclDirs === "empty"
                        ? "excluded_directories = []"
                        : 'excluded_directories = [".idea", ".vscode", ".vs", "node_modules", ".yarn", "target", "dist", "build", "vendor"]',
                ]);
            }

            // [index.language_support]
            if (s.docSupport !== DEFAULT_STATE.docSupport) mod++;
            if (full || s.docSupport !== DEFAULT_STATE.docSupport) {
                push("[index.language_support]", [`is_document_support_enabled = ${s.docSupport}`]);
            }

            // [filesystem_permissions]
            if (s.fsPerm !== DEFAULT_STATE.fsPerm) mod++;
            if (full || s.fsPerm !== DEFAULT_STATE.fsPerm) {
                const permBlock = [
                    `find = "${s.fsPerm}"`,
                    `grep = "${s.fsPerm}"`,
                    `read = "${s.fsPerm}"`,
                ];
                if (s.fsPerm === "allowed_roots") {
                    permBlock.push('allowed_roots = ["../grafana-plugins"]');
                }
                push("[filesystem_permissions]", permBlock);
            }

            // [related_terms]
            if (s.synonymsEnabled !== DEFAULT_STATE.synonymsEnabled) mod++;
            if (full || s.synonymsEnabled !== DEFAULT_STATE.synonymsEnabled) {
                push("[related_terms]", [`enabled = ${s.synonymsEnabled}`]);
            }

            if (s.includeSeen !== DEFAULT_STATE.includeSeen) mod++;

            if (sections.length === 0) {
                const comment =
                    this.locale === "ko"
                        ? "# 모든 설정이 기본값입니다. 바꿀 키만 .codemap/config.toml에 적으세요."
                        : "# Using all built-in defaults. Add only keys you want to override.";
                return { text: comment, modifiedCount: mod };
            }

            const body = sections.map(([hdr, lns]) => `${hdr}\n${lns.join("\n")}`).join("\n\n");
            return { text: body, modifiedCount: mod };
        }

        private maskValue(
            s: PgState,
            kind: "secret" | "shortSecret" | "urlPass" | "sensWebhook" | "glsa" | "email" | "ip" | "rrn" | "card",
            raw: string,
        ): string {
            if (!s.redactEnabled) return raw;
            if (kind === "secret") return "[REDACTED]";
            if (kind === "shortSecret") return "*".repeat(raw.length);
            if (kind === "urlPass") return "********";
            if (kind === "sensWebhook") return s.sensWebhook ? "[REDACTED]" : raw;
            if (kind === "glsa") return s.customRule ? "glsa_[REDACTED]" : raw;
            if (kind === "email") return s.piiEntities.includes("EMAIL_ADDRESS") ? "[REDACTED]" : raw;
            if (kind === "ip") return s.piiEntities.includes("IP_ADDRESS") ? "[REDACTED]" : raw;
            if (kind === "rrn") return s.piiEntities.includes("KR_RRN") ? "[REDACTED]" : raw;
            if (kind === "card") return s.piiEntities.includes("CREDIT_CARD") ? "[REDACTED]" : raw;
            return raw;
        }

        private computeOutputs(s: PgState): ToolRender[] {
            const taskPrompt =
                this.locale === "ko"
                    ? "대시보드 저장 시 버전 충돌 오류가 반환되는 경로 확인"
                    : "Trace how dashboard save returns a version mismatch error";

            // 1. SEARCH
            const searchCallObj: Record<string, unknown> = {
                query: "SaveDashboard webhook",
                workspace_scope: "pkg",
            };
            if (s.includeSeen) searchCallObj.include_seen = true;
            const searchCall = JSON.stringify({ name: "search", arguments: searchCallObj });

            const searchLines: string[] = [];
            if (s.indexMode === "off") {
                searchLines.push(
                    'Index unavailable: workspace indexing is disabled ([index].mode = "off"). Live filesystem tools (read, grep, find) remain available.',
                );
            } else {
                searchLines.push('_Workspace scope: `pkg`. Pass `workspace_scope: "all"` for repo-wide search._');
                searchLines.push("# codemap-search");
                searchLines.push("");
                searchLines.push("## 1. pkg/services/dashboards/service/dashboard_service.go");
                searchLines.push("- `method DashboardServiceImpl.SaveDashboard` (L142-153)");

                if (s.contextEnabled) {
                    const callerHdr = s.navPrecise
                        ? "  - _callers (tree-sitter precise; import/source resolution confirmed):_"
                        : "  - _callers (approximate name scan):_";
                    searchLines.push(callerHdr);

                    const callers: string[] = [
                        s.navPrecise
                            ? "    - `pkg/api/dashboard.go:318` (`HTTPServer.PostDashboard`, precise)"
                            : "    - `pkg/api/dashboard.go:318` (`HTTPServer.PostDashboard`)",
                        s.navPrecise
                            ? "    - `pkg/services/provisioning/dashboards/file_reader.go:204` (`FileReader.saveDashboard`, precise)"
                            : "    - `pkg/services/provisioning/dashboards/file_reader.go:204` (`FileReader.saveDashboard`)",
                    ];
                    if (s.storeRefs) {
                        callers.push(
                            "    - `pkg/registry/apis/dashboards/legacy.go:64` (`SaveDashboardDTO` reference)",
                        );
                    }
                    if (s.includeTests) {
                        callers.push(
                            "    - `pkg/services/dashboards/service/dashboard_service_test.go:88` (`TestSaveDashboard`)",
                        );
                    }
                    const shownCallers = callers.slice(0, s.callerLimit);
                    searchLines.push(...shownCallers);
                    if (callers.length > s.callerLimit) {
                        searchLines.push(
                            `    - _(+${callers.length - s.callerLimit} more omitted by output.context.caller_limit=${s.callerLimit})_`,
                        );
                    }

                    searchLines.push(
                        s.navPrecise
                            ? "  - _calls (depth 1, tree-sitter precise):_"
                            : "  - _calls (depth 1, approximate):_",
                    );
                    searchLines.push(
                        s.navPrecise
                            ? "    - `DashboardServiceImpl.buildSaveDashboardCommand` — `pkg/services/dashboards/service/dashboard_service.go:96` (`precise`)"
                            : "    - `buildSaveDashboardCommand` — `pkg/services/dashboards/service/dashboard_service.go:96`",
                    );
                }

                if (s.eventsEnabled) {
                    searchLines.push("  - _events (static bus routes):_");
                    searchLines.push(
                        "    - publish `events.DashboardSaved` → subscribe `pkg/services/live/features/dashboard.go:91`",
                    );
                }

                searchLines.push("");
                searchLines.push("### results");
                const fullSaveLines = [
                    "142→func (dr *DashboardServiceImpl) SaveDashboard(ctx context.Context, dto *dashboards.SaveDashboardDTO) (*dashboards.Dashboard, error) {",
                    "143→    cmd, err := dr.buildSaveDashboardCommand(ctx, dto)",
                    "144→    if errors.Is(err, dashboards.ErrDashboardVersionMismatch) {",
                    "145→        return nil, err",
                    "146→    }",
                    "147→    res, err := dr.store.SaveDashboard(ctx, *cmd)",
                    "148→    if err != nil {",
                    "149→        return nil, err",
                    "150→    }",
                    "151→    dr.bus.Publish(ctx, &events.DashboardSaved{UID: res.UID})",
                    "152→    return res, nil",
                    "153→}",
                ];
                if (s.snippetMaxLines < fullSaveLines.length) {
                    searchLines.push(...fullSaveLines.slice(0, s.snippetMaxLines));
                    searchLines.push(
                        `... [snippet capped at ${s.snippetMaxLines} lines; read pkg/services/dashboards/service/dashboard_service.go L${142 + s.snippetMaxLines}-153]`,
                    );
                } else {
                    searchLines.push(...fullSaveLines);
                }

                // Second symbol in file 1: DeleteDashboard (reacts to Jev & include_seen)
                if (s.jevEnabled && s.jevScope.includes("search")) {
                    searchLines.push(
                        `- _omitted body: L210-226 (method DeleteDashboard) Jev (${s.jevModel}) found no task match in pkg/services/dashboards/service/dashboard_service.go._`,
