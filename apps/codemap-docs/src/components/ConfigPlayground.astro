                                : [
                                      "## 2. pkg/services/notifications/mailer.go",
                                      "- `method WebhookSender.SendWebhook` (L38-46)",
                                      `39→    authHeader := "Bearer ${this.maskValue(s, "secret", "eyJhbGciOiJIUzI1NiJ9.grafana.sig")}"`,
                                      `40→    webhookSigningKey := "${this.maskValue(s, "sensWebhook", "whsec_live_98a7bc65d4ef3210")}"`,
                                      `41→    serviceToken := "${this.maskValue(s, "glsa", "glsa_8Kp2Lm9Qx4Vz7Rn1Yt6Bc3Df")}"`,
                                      `42→    notifyFrom := "${this.maskValue(s, "email", "alerts@grafana.example.com")}"`,
                                  ],
                    },
                ];

                if (s.docSupport) {
                    extraCandidates.push({
                        path: "docs/sources/dashboards/build-dashboards/save-dashboard.md",
                        detail: [
                            `## ${extraCandidates.length + 2}. docs/sources/dashboards/build-dashboards/save-dashboard.md`,
