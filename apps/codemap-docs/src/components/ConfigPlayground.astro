---
interface Props {
    locale: "en" | "ko";
}

const { locale } = Astro.props;
const isKo = locale === "ko";

const ui = {
    docsLink: isKo ? "← 설정 레퍼런스" : "← Config Reference",
    docsHref: isKo ? "/ko/configuration/" : "/configuration/",
    presetDefault: isKo ? "기본값" : "Defaults",
    presetPrecise: isKo ? "정밀 호출·참조" : "Precise & Refs",
    presetJev: isKo ? "Jev·토큰 절약" : "Jev & Compact",
    presetSecurity: isKo ? "보안·PII 강화" : "Strict PII",
    presetBroad: isKo ? "테스트·문서 확장" : "Tests & Docs",
    resetBtn: isKo ? "초기화" : "Reset",
    copyToml: isKo ? "config.toml 복사" : "Copy config.toml",
    copyShort: isKo ? "복사" : "Copy",
    copiedMsg: isKo ? "복사됨" : "Copied",
    copyFailedMsg: isKo ? "복사 실패" : "Copy failed",
    defaultBadge: isKo ? "기본 설정" : "All defaults",
    statusFmt: isKo ? "변경 {m}개 · 영향 도구 {t}/7" : "{m} modified · {t}/7 tools",
    catAll: isKo ? "전체" : "All",
    catContext: isKo ? "호출·문맥" : "Context",
    catLimits: isKo ? "출력·한도" : "Limits",
    catRedact: isKo ? "마스킹" : "Redaction",
    catJev: "Jev",
    catIndex: isKo ? "색인·권한" : "Index & Scope",
    filterPlaceholder: isKo ? "키 필터 (예: pii, max, jev)" : "Filter keys (e.g. pii, max, jev)",
    tomlChangedOnly: isKo ? "변경 키만" : "Modified",
    tomlFull: isKo ? "전체 키" : "Full",
    groupContext: isKo ? "호출·이벤트 문맥" : "Call & Event Context",
    groupLimits: isKo ? "도구별 출력 한도·접기" : "Output Limits & Folding",
    groupRedact: isKo ? "인증정보·PII 마스킹" : "Credential & PII Masking",
    groupJev: isKo ? "Jev 작업 관련성 필터" : "Jev Relevance Filter",
    groupIndex: isKo ? "색인·권한·확장 도구" : "Index, Permissions & Extras",
    lblContextEnabled: isKo ? "search 기본 호출 관계 표시" : "Show callers/callees in search",
    lblNavPrecise: isKo ? "구조·import 정밀 확인 (precise)" : "Structural import verification (precise)",
    lblCallerLimit: isKo ? "심볼당 최대 호출자 수" : "Max callers per symbol",
    lblIncludeTests: isKo ? "호출 문맥에 테스트 파일 포함" : "Include test files in callers",
    lblEvents: isKo ? "정적 이벤트 발행·구독 경로" : "Static event publish/subscribe routes",
    lblDetailFiles: isKo ? "상세 발췌 상위 파일 수" : "Detailed snippet file limit",
    lblSnippetLines: isKo ? "심볼당 최대 발췌 줄 수" : "Max snippet lines per symbol",
    lblOutsideCallers: isKo ? "read 끝에 범위 밖 호출자 표시" : "Append outside callers in read",
    lblGrepCols: isKo ? "grep 줄 길이 상한 (0=무제한)" : "grep max line width (0=unlimited)",
    lblIncludeSeen: isKo ? "이미 본 중복 구간 재출력" : "Re-print seen lines (include_seen)",
    lblRedactMaster: isKo ? "인증정보·선택 PII 자동 마스킹" : "Mask credentials & opted-in PII",
    lblPiiEntities: isKo ? "추가 내장 PII 유형" : "Opt-in PII entity types",
    lblSensField: isKo ? "민감 필드 추가 (webhookSigningKey)" : "Extra secret field (webhookSigningKey)",
    lblCustomRule: isKo ? "사용자 정규식 (glsa_ 부분 마스킹)" : "Custom regex (glsa_ partial mask)",
    lblJevEnabled: isKo ? "Jev 판정 필터 활성화" : "Enable Jev decision filter",
    lblJevScope: isKo ? "필터 적용 도구" : "Filtered tools",
    lblJevModel: isKo ? "판정 모델 ID" : "Decision model ID",
    lblIndexMode: isKo ? "색인 실행 모드" : "Indexing mode",
    lblStoreRefs: isKo ? "비호출 심볼 참조도 색인" : "Index non-call references",
    lblExcludedDirs: isKo ? "선택 디렉터리 제외 목록" : "Optional directory exclusions",
    optDirsDefault: isKo ? "기본 목록" : "Defaults",
    optDirsEmpty: isKo ? "[] 해제" : "[] None",
    lblDocSupport: isKo ? "Markdown (.md/.mdx) 색인" : "Index Markdown (.md/.mdx)",
    lblPerms: isKo ? "파일 접근 범위" : "Filesystem access scope",
    lblSynonyms: isKo ? "synonyms 유의어 도구 활성화" : "Enable synonyms tool",
    lblGlobalInst: isKo ? "클라이언트 전역 지침 자동 동기화" : "Sync client global instructions",
    outLabel: isKo ? "grafana/grafana 도구 출력" : "grafana/grafana Tool Output",
    tabAll: isKo ? "전체 7" : "All 7",
    modeOutput: isKo ? "출력" : "Output",
    modeDiff: isKo ? "비교 (Diff)" : "Diff",
    changedOnly: isKo ? "변경만" : "Changed only",
    unchangedBadge: isKo ? "기본" : "Default",
    modifiedBadge: isKo ? "변경됨" : "Modified",
    noChangedTools: isKo
        ? "모든 도구가 기본 설정 출력과 같습니다. 왼쪽에서 옵션을 전환해 보세요."
        : "All tools currently match default output. Toggle an option on the left.",
    noFilterMatch: isKo ? "일치하는 설정 키가 없습니다." : "No matching configuration keys.",
};

const clientPayload = JSON.stringify({ locale, ui });
---

<codemap-config-playground class="wb-root not-content" data-pg={clientPayload}>
    <!-- Top Workbench Command Bar -->
    <div class="wb-topbar">
        <div class="wb-top-left">
            <a href={ui.docsHref} class="wb-back-link">{ui.docsLink}</a>
            <span class="wb-vsep" aria-hidden="true"></span>
            <div class="wb-presets" role="toolbar" aria-label="Presets">
                <button type="button" class="wb-preset is-active" data-preset="default">{ui.presetDefault}</button>
                <button type="button" class="wb-preset" data-preset="precise">{ui.presetPrecise}</button>
                <button type="button" class="wb-preset" data-preset="jev">{ui.presetJev}</button>
                <button type="button" class="wb-preset" data-preset="security">{ui.presetSecurity}</button>
                <button type="button" class="wb-preset" data-preset="broad">{ui.presetBroad}</button>
            </div>
        </div>

        <div class="wb-top-right">
            <span class="wb-telemetry" data-telemetry>{ui.defaultBadge}</span>
            <button type="button" class="wb-btn-ghost" data-reset>{ui.resetBtn}</button>
            <span class="wb-copy-wrap">
                <button
                    type="button"
                    class="wb-btn-primary pg-copy-btn"
                    command="--copy"
                    commandfor="pg-toml-code"
                >
                    <span class="pg-copy-icon" aria-hidden="true"></span>
                    <span>{ui.copyToml}</span>
                </button>
                <span class="pg-copy-tip" role="status"></span>
            </span>
        </div>
    </div>

    <!-- Split IDE Pane -->
    <div class="wb-grid">
        <!-- LEFT PANE: Compact IDE Settings + Docked TOML Code Preview -->
        <div class="wb-left">
            <div class="wb-subbar">
                <search class="wb-search">
                    <input
                        type="search"
                        class="wb-search-input"
                        data-key-filter
                        placeholder={ui.filterPlaceholder}
                        aria-label={ui.filterPlaceholder}
                        autocorrect="off"
                        autocapitalize="none"
                        spellcheck="false"
                    />
                </search>
                <div class="wb-cats" role="tablist" aria-label="Setting categories">
                    <button type="button" role="tab" aria-selected="true" class="wb-cat" data-cat-btn="all">{ui.catAll}</button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" class="wb-cat" data-cat-btn="context">{ui.catContext}</button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" class="wb-cat" data-cat-btn="limits">{ui.catLimits}</button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" class="wb-cat" data-cat-btn="redact">{ui.catRedact}</button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" class="wb-cat" data-cat-btn="jev">{ui.catJev}</button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" class="wb-cat" data-cat-btn="index">{ui.catIndex}</button>
                </div>
            </div>

            <form class="wb-settings" data-pg-form>
                <!-- Group 1: Context -->
                <div class="wb-group" data-cat-group="context">
                    <div class="wb-group-hdr">{ui.groupContext}</div>

                    <div class="wb-row" data-setting="contextEnabled" data-keywords="output.context.is_enabled caller callee search">
                        <label class="wb-row-info" for="pg-ctx-enabled">
                            <span class="wb-row-title">{ui.lblContextEnabled}</span>
                            <code class="wb-row-key">[output.context].is_enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-ctx-enabled" name="contextEnabled" checked />
                    </div>

                    <div class="wb-row" data-setting="navPrecise" data-keywords="output.navigation.is_enabled precise tree-sitter import">
                        <label class="wb-row-info" for="pg-nav-precise">
                            <span class="wb-row-title">{ui.lblNavPrecise}</span>
                            <code class="wb-row-key">[output.navigation].is_enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-nav-precise" name="navPrecise" />
                    </div>

                    <div class="wb-row" data-setting="callerLimit" data-keywords="output.context.caller_limit max callers">
                        <div class="wb-row-info" id="lbl-caller-limit">
                            <span class="wb-row-title">{ui.lblCallerLimit}</span>
                            <code class="wb-row-key">[output.context].caller_limit</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-caller-limit">
                            <label><input type="radio" name="callerLimit" value="1000" checked /><span>1000</span></label>
                            <label><input type="radio" name="callerLimit" value="2" /><span>2</span></label>
                            <label><input type="radio" name="callerLimit" value="1" /><span>1</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="includeTests" data-keywords="output.context.exclude.should_include_test_code test">
                        <label class="wb-row-info" for="pg-inc-tests">
                            <span class="wb-row-title">{ui.lblIncludeTests}</span>
                            <code class="wb-row-key">[output.context.exclude].should_include_test_code</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-inc-tests" name="includeTests" />
                    </div>

                    <div class="wb-row" data-setting="eventsEnabled" data-keywords="output.event_navigation.is_enabled event publish subscribe">
                        <label class="wb-row-info" for="pg-events">
                            <span class="wb-row-title">{ui.lblEvents}</span>
                            <code class="wb-row-key">[output.event_navigation].is_enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-events" name="eventsEnabled" checked />
                    </div>
                </div>

                <!-- Group 2: Output Limits -->
                <div class="wb-group" data-cat-group="limits">
                    <div class="wb-group-hdr">{ui.groupLimits}</div>

                    <div class="wb-row" data-setting="detailFileLimit" data-keywords="output.search.detail_file_limit ranked tail">
                        <div class="wb-row-info" id="lbl-detail-files">
                            <span class="wb-row-title">{ui.lblDetailFiles}</span>
                            <code class="wb-row-key">[output.search].detail_file_limit</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-detail-files">
                            <label><input type="radio" name="detailFileLimit" value="24" checked /><span>24</span></label>
                            <label><input type="radio" name="detailFileLimit" value="2" /><span>2</span></label>
                            <label><input type="radio" name="detailFileLimit" value="1" /><span>1</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="snippetMaxLines" data-keywords="output.search.snippet_max_lines max lines truncate">
                        <div class="wb-row-info" id="lbl-snippet-lines">
                            <span class="wb-row-title">{ui.lblSnippetLines}</span>
                            <code class="wb-row-key">[output.search].snippet_max_lines</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-snippet-lines">
                            <label><input type="radio" name="snippetMaxLines" value="500" checked /><span>500</span></label>
                            <label><input type="radio" name="snippetMaxLines" value="6" /><span>6</span></label>
                            <label><input type="radio" name="snippetMaxLines" value="3" /><span>3</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="outsideCallers" data-keywords="output.read.is_outside_callers_enabled read callers">
                        <label class="wb-row-info" for="pg-outside-callers">
                            <span class="wb-row-title">{ui.lblOutsideCallers}</span>
                            <code class="wb-row-key">[output.read].is_outside_callers_enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-outside-callers" name="outsideCallers" checked />
                    </div>

                    <div class="wb-row" data-setting="grepMaxColumns" data-keywords="output.grep.max_columns grep width line">
                        <div class="wb-row-info" id="lbl-grep-cols">
                            <span class="wb-row-title">{ui.lblGrepCols}</span>
                            <code class="wb-row-key">[output.grep].max_columns</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-grep-cols">
                            <label><input type="radio" name="grepMaxColumns" value="0" checked /><span>0</span></label>
                            <label><input type="radio" name="grepMaxColumns" value="90" /><span>90</span></label>
                            <label><input type="radio" name="grepMaxColumns" value="60" /><span>60</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="includeSeen" data-keywords="include_seen duplicate fold">
                        <label class="wb-row-info" for="pg-inc-seen">
                            <span class="wb-row-title">{ui.lblIncludeSeen}</span>
                            <code class="wb-row-key">include_seen (MCP arg)</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-inc-seen" name="includeSeen" />
                    </div>
                </div>

                <!-- Group 3: Redaction -->
                <div class="wb-group" data-cat-group="redact">
                    <div class="wb-group-hdr">{ui.groupRedact}</div>

                    <div class="wb-row" data-setting="redactEnabled" data-keywords="output.is_redact_enabled secret password token mask">
                        <label class="wb-row-info" for="pg-redact-master">
                            <span class="wb-row-title">{ui.lblRedactMaster}</span>
                            <code class="wb-row-key">[output].is_redact_enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-redact-master" name="redactEnabled" checked />
                    </div>

                    <div class="wb-row wb-row-stack" data-setting="piiEntities" data-keywords="output.redact.pii_entities email ip kr_rrn credit_card pii">
                        <div class="wb-row-info" id="lbl-pii-entities">
                            <span class="wb-row-title">{ui.lblPiiEntities}</span>
                            <code class="wb-row-key">[output.redact].pii_entities</code>
                        </div>
                        <div class="wb-chips" role="group" aria-labelledby="lbl-pii-entities">
                            <label class="wb-chip"><input type="checkbox" name="pii_EMAIL_ADDRESS" /><span>EMAIL_ADDRESS</span></label>
                            <label class="wb-chip"><input type="checkbox" name="pii_IP_ADDRESS" /><span>IP_ADDRESS</span></label>
                            <label class="wb-chip"><input type="checkbox" name="pii_KR_RRN" /><span>KR_RRN</span></label>
                            <label class="wb-chip"><input type="checkbox" name="pii_CREDIT_CARD" /><span>CREDIT_CARD</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="sensWebhook" data-keywords="output.redact.sensitive_fields webhookSigningKey">
                        <label class="wb-row-info" for="pg-sens-field">
                            <span class="wb-row-title">{ui.lblSensField}</span>
                            <code class="wb-row-key">[output.redact].sensitive_fields</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-sens-field" name="sensWebhook" />
                    </div>

                    <div class="wb-row" data-setting="customRule" data-keywords="output.redact.rules regex glsa custom">
                        <label class="wb-row-info" for="pg-custom-rule">
                            <span class="wb-row-title">{ui.lblCustomRule}</span>
                            <code class="wb-row-key">[output.redact].rules</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-custom-rule" name="customRule" />
                    </div>
                </div>

                <!-- Group 4: Jev -->
                <div class="wb-group" data-cat-group="jev">
                    <div class="wb-group-hdr">{ui.groupJev}</div>

                    <div class="wb-row" data-setting="jevEnabled" data-keywords="output.jev.enabled task decision filter">
                        <label class="wb-row-info" for="pg-jev-enabled">
                            <span class="wb-row-title">{ui.lblJevEnabled}</span>
                            <code class="wb-row-key">[output.jev].enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-jev-enabled" name="jevEnabled" />
                    </div>

                    <div class="wb-row wb-row-stack" data-setting="jevScope" data-keywords="output.jev.scope search read grep">
                        <div class="wb-row-info" id="lbl-jev-scope">
                            <span class="wb-row-title">{ui.lblJevScope}</span>
                            <code class="wb-row-key">[output.jev].scope</code>
                        </div>
                        <div class="wb-chips" role="group" aria-labelledby="lbl-jev-scope">
                            <label class="wb-chip"><input type="checkbox" name="jev_search" checked /><span>search</span></label>
                            <label class="wb-chip"><input type="checkbox" name="jev_read" checked /><span>read</span></label>
                            <label class="wb-chip"><input type="checkbox" name="jev_grep" checked /><span>grep</span></label>
                        </div>
                    </div>

                    <div class="wb-row wb-row-stack" data-setting="jevModel" data-keywords="output.jev.model openrouter luna pplx">
                        <label class="wb-row-info" for="pg-jev-model">
                            <span class="wb-row-title">{ui.lblJevModel}</span>
                            <code class="wb-row-key">[output.jev].model</code>
                        </label>
                        <select id="pg-jev-model" name="jevModel" class="wb-select">
                            <option value="jev-1.14.0">jev-1.14.0 (TypeSafe)</option>
                            <option value="openai/gpt-6-luna-decisions">openai/gpt-6-luna-decisions</option>
                            <option value="perplexity/pplx-decider-flash-v1.2">perplexity/pplx-decider-flash-v1.2</option>
                        </select>
                    </div>
                </div>

                <!-- Group 5: Index & Permissions -->
                <div class="wb-group" data-cat-group="index">
                    <div class="wb-group-hdr">{ui.groupIndex}</div>

                    <div class="wb-row" data-setting="indexMode" data-keywords="index.mode auto on off">
                        <div class="wb-row-info" id="lbl-index-mode">
                            <span class="wb-row-title">{ui.lblIndexMode}</span>
                            <code class="wb-row-key">[index].mode</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-index-mode">
                            <label><input type="radio" name="indexMode" value="auto" checked /><span>auto</span></label>
                            <label><input type="radio" name="indexMode" value="on" /><span>on</span></label>
                            <label><input type="radio" name="indexMode" value="off" /><span>off</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="storeRefs" data-keywords="index.store_references references">
                        <label class="wb-row-info" for="pg-store-refs">
                            <span class="wb-row-title">{ui.lblStoreRefs}</span>
                            <code class="wb-row-key">[index].store_references</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-store-refs" name="storeRefs" />
                    </div>

                    <div class="wb-row" data-setting="exclDirs" data-keywords="index.exclude.excluded_directories vendor build">
                        <div class="wb-row-info" id="lbl-excl-dirs">
                            <span class="wb-row-title">{ui.lblExcludedDirs}</span>
                            <code class="wb-row-key">[index.exclude].excluded_directories</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-excl-dirs">
                            <label><input type="radio" name="exclDirs" value="default" checked /><span>{ui.optDirsDefault}</span></label>
                            <label><input type="radio" name="exclDirs" value="empty" /><span>{ui.optDirsEmpty}</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="docSupport" data-keywords="index.language_support.is_document_support_enabled markdown md mdx">
                        <label class="wb-row-info" for="pg-doc-support">
                            <span class="wb-row-title">{ui.lblDocSupport}</span>
                            <code class="wb-row-key">[index.language_support].is_document_support_enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-doc-support" name="docSupport" />
                    </div>

                    <div class="wb-row wb-row-stack" data-setting="fsPerm" data-keywords="filesystem_permissions anywhere workspace allowed_roots">
                        <div class="wb-row-info" id="lbl-perms">
                            <span class="wb-row-title">{ui.lblPerms}</span>
                            <code class="wb-row-key">[filesystem_permissions].find / grep / read</code>
                        </div>
                        <div class="wb-seg" role="radiogroup" aria-labelledby="lbl-perms">
                            <label><input type="radio" name="fsPerm" value="anywhere" checked /><span>anywhere</span></label>
                            <label><input type="radio" name="fsPerm" value="workspace" /><span>workspace</span></label>
                            <label><input type="radio" name="fsPerm" value="allowed_roots" /><span>allowed_roots</span></label>
                        </div>
                    </div>

                    <div class="wb-row" data-setting="synonymsEnabled" data-keywords="related_terms.enabled synonyms">
                        <label class="wb-row-info" for="pg-synonyms">
                            <span class="wb-row-title">{ui.lblSynonyms}</span>
                            <code class="wb-row-key">[related_terms].enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-synonyms" name="synonymsEnabled" />
                    </div>

                    <div class="wb-row" data-setting="globalInst" data-keywords="global_instructions.enabled agents claude codex">
                        <label class="wb-row-info" for="pg-global-inst">
                            <span class="wb-row-title">{ui.lblGlobalInst}</span>
                            <code class="wb-row-key">[global_instructions].enabled</code>
                        </label>
                        <input type="checkbox" class="wb-switch" id="pg-global-inst" name="globalInst" />
                    </div>
                </div>

                <p class="wb-empty-filter" data-empty-filter hidden>{ui.noFilterMatch}</p>
            </form>

            <!-- Docked Live config.toml Preview -->
            <div class="wb-toml-dock">
                <div class="wb-toml-bar">
                    <code class="wb-toml-file">.codemap/config.toml</code>
                    <div class="wb-toml-ctrls">
                        <div class="wb-mini-seg" role="group" aria-label="TOML output mode">
                            <button type="button" data-toml-mode="diff" aria-pressed="true">{ui.tomlChangedOnly}</button>
                            <button type="button" data-toml-mode="full" aria-pressed="false">{ui.tomlFull}</button>
                        </div>
                        <span class="wb-copy-wrap">
                            <button
                                type="button"
                                class="wb-mini-copy pg-copy-btn"
                                command="--copy"
                                commandfor="pg-toml-code"
                            >
                                <span class="pg-copy-icon" aria-hidden="true"></span>
                                <span>{ui.copyShort}</span>
                            </button>
                            <span class="pg-copy-tip" role="status"></span>
                        </span>
                    </div>
                </div>
                <pre class="wb-toml-pre" tabindex="0" role="region" aria-label=".codemap/config.toml"><code id="pg-toml-code" data-toml-out></code></pre>
            </div>
        </div>

        <!-- RIGHT PANE: MCP Output Inspector -->
        <div class="wb-right">
            <div class="wb-insp-bar">
                <div class="pg-tablist" role="tablist" aria-label={ui.outLabel}>
                    <button type="button" role="tab" aria-selected="true" data-tool-tab="all">
                        <span data-all-tab-label>{ui.tabAll}</span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="search">
                        <span>search</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="read">
                        <span>read</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="grep">
                        <span>grep</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="find">
                        <span>find</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="initial_instructions">
                        <span>initial_instructions</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="analyze">
                        <span>analyze</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                    <button type="button" role="tab" aria-selected="false" tabindex="-1" data-tool-tab="synonyms">
                        <span>synonyms</span><span class="pg-tab-dot" aria-hidden="true"></span>
                    </button>
                </div>

                <div class="wb-insp-opts">
                    <div class="wb-mini-seg" role="group" aria-label="Inspector view">
                        <button type="button" data-view-mode="output" aria-pressed="true">{ui.modeOutput}</button>
                        <button type="button" data-view-mode="diff" aria-pressed="false">{ui.modeDiff}</button>
                    </div>
                    <button type="button" class="wb-filter-pill" data-changed-only aria-pressed="false">
                        {ui.changedOnly}
                    </button>
                </div>
            </div>

            <div class="wb-stream" role="tabpanel" aria-label={ui.outLabel} data-outputs-panel></div>
        </div>
    </div>
</codemap-config-playground>

<script>
    interface PgState {
        contextEnabled: boolean;
        navPrecise: boolean;
        callerLimit: number;
        includeTests: boolean;
        eventsEnabled: boolean;
        detailFileLimit: number;
        snippetMaxLines: number;
        outsideCallers: boolean;
        grepMaxColumns: number;
        includeSeen: boolean;
        redactEnabled: boolean;
        piiEntities: string[];
        sensWebhook: boolean;
        customRule: boolean;
        jevEnabled: boolean;
        jevScope: string[];
        jevModel: string;
        indexMode: "auto" | "on" | "off";
        storeRefs: boolean;
        exclDirs: "default" | "empty";
        docSupport: boolean;
        fsPerm: "anywhere" | "workspace" | "allowed_roots";
        synonymsEnabled: boolean;
        globalInst: boolean;
    }

    interface ToolRender {
        id: string;
        params: Array<[string, string]>;
        lines: string[];
    }

    const DEFAULT_STATE: PgState = {
        contextEnabled: true,
        navPrecise: false,
        callerLimit: 1000,
        includeTests: false,
        eventsEnabled: true,
        detailFileLimit: 24,
        snippetMaxLines: 500,
        outsideCallers: true,
        grepMaxColumns: 0,
        includeSeen: false,
        redactEnabled: true,
        piiEntities: [],
        sensWebhook: false,
        customRule: false,
        jevEnabled: false,
        jevScope: ["search", "read", "grep"],
        jevModel: "jev-1.14.0",
        indexMode: "auto",
        storeRefs: false,
        exclDirs: "default",
        docSupport: false,
        fsPerm: "anywhere",
        synonymsEnabled: false,
        globalInst: false,
    };

    const PRESETS: Record<string, Partial<PgState>> = {
        default: {},
        precise: {
            navPrecise: true,
            storeRefs: true,
            synonymsEnabled: true,
        },
        jev: {
            jevEnabled: true,
            detailFileLimit: 1,
            snippetMaxLines: 6,
            grepMaxColumns: 90,
        },
        security: {
            redactEnabled: true,
            piiEntities: ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN", "CREDIT_CARD"],
            sensWebhook: true,
            customRule: true,
            fsPerm: "workspace",
        },
        broad: {
            includeTests: true,
            docSupport: true,
            exclDirs: "empty",
            includeSeen: true,
        },
    };

    const copyTimers = new WeakMap<HTMLElement, number>();
    let lastStatusText = "";

    /** Compute line-level LCS diff between base and current lines. */
    function computeLineDiff(
        base: string[],
        curr: string[],
    ): Array<{ kind: "same" | "del" | "add"; text: string; lineNo: string }> {
        const m = base.length;
        const n = curr.length;
        const dp: number[][] = Array.from({ length: m + 1 }, () => Array<number>(n + 1).fill(0));
        for (let i = m - 1; i >= 0; i--) {
            for (let j = n - 1; j >= 0; j--) {
                dp[i][j] =
                    base[i] === curr[j] ? dp[i + 1][j + 1] + 1 : Math.max(dp[i + 1][j], dp[i][j + 1]);
            }
        }
        const out: Array<{ kind: "same" | "del" | "add"; text: string; lineNo: string }> = [];
        let i = 0;
        let j = 0;
        let newLine = 1;
        while (i < m && j < n) {
            if (base[i] === curr[j]) {
                out.push({ kind: "same", text: curr[j], lineNo: String(newLine++) });
                i++;
                j++;
            } else if (dp[i + 1][j] >= dp[i][j + 1]) {
                out.push({ kind: "del", text: base[i], lineNo: "−" });
                i++;
            } else {
                out.push({ kind: "add", text: curr[j], lineNo: String(newLine++) });
                j++;
            }
        }
        while (i < m) {
            out.push({ kind: "del", text: base[i++], lineNo: "−" });
        }
        while (j < n) {
            out.push({ kind: "add", text: curr[j++], lineNo: String(newLine++) });
        }
        return out;
    }

    class CodemapConfigPlayground extends HTMLElement {
        private locale: "en" | "ko" = "ko";
        private ui: Record<string, string> = {};
        private tomlMode: "diff" | "full" = "diff";
        private selectedCat = "all";
        private filterQuery = "";
        private selectedTab = "all";
        private viewMode: "output" | "diff" = "output";
        private changedToolsOnly = false;
        private baselineOutputs: Map<string, ToolRender> = new Map();

        connectedCallback() {
            const raw = this.dataset.pg;
            if (!raw) return;
            const parsed = JSON.parse(raw) as { locale: "en" | "ko"; ui: Record<string, string> };
            this.locale = parsed.locale;
            this.ui = parsed.ui;

            for (const item of this.computeOutputs(DEFAULT_STATE)) {
                this.baselineOutputs.set(item.id, item);
            }

            this.wireControls();
            this.wireCopyButtons();
            this.render();
        }

        private readStateFromForm(): PgState {
            const form = this.querySelector<HTMLFormElement>("[data-pg-form]");
            if (!form) return { ...DEFAULT_STATE };
            const fd = new FormData(form);

            const piiEntities: string[] = [];
            for (const ent of ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN", "CREDIT_CARD"]) {
                if (fd.has(`pii_${ent}`)) piiEntities.push(ent);
            }

            const jevScope: string[] = [];
            for (const sc of ["search", "read", "grep"]) {
                if (fd.has(`jev_${sc}`)) jevScope.push(sc);
            }

            return {
                contextEnabled: fd.has("contextEnabled"),
                navPrecise: fd.has("navPrecise"),
                callerLimit: Number(fd.get("callerLimit") ?? 1000),
                includeTests: fd.has("includeTests"),
                eventsEnabled: fd.has("eventsEnabled"),
                detailFileLimit: Number(fd.get("detailFileLimit") ?? 24),
                snippetMaxLines: Number(fd.get("snippetMaxLines") ?? 500),
                outsideCallers: fd.has("outsideCallers"),
                grepMaxColumns: Number(fd.get("grepMaxColumns") ?? 0),
                includeSeen: fd.has("includeSeen"),
                redactEnabled: fd.has("redactEnabled"),
                piiEntities,
                sensWebhook: fd.has("sensWebhook"),
                customRule: fd.has("customRule"),
                jevEnabled: fd.has("jevEnabled"),
                jevScope,
                jevModel: String(fd.get("jevModel") ?? "jev-1.14.0"),
                indexMode: (fd.get("indexMode") as PgState["indexMode"]) ?? "auto",
                storeRefs: fd.has("storeRefs"),
                exclDirs: (fd.get("exclDirs") as PgState["exclDirs"]) ?? "default",
                docSupport: fd.has("docSupport"),
                fsPerm: (fd.get("fsPerm") as PgState["fsPerm"]) ?? "anywhere",
                synonymsEnabled: fd.has("synonymsEnabled"),
                globalInst: fd.has("globalInst"),
            };
        }

        private applyStateToForm(state: PgState) {
            const form = this.querySelector<HTMLFormElement>("[data-pg-form]");
            if (!form) return;

            const setCheck = (name: string, val: boolean) => {
                const el = form.elements.namedItem(name) as HTMLInputElement | null;
                if (el) el.checked = val;
            };
            const setRadio = (name: string, val: string) => {
                const list = form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]`);
                for (const r of list) r.checked = r.value === val;
            };

            setCheck("contextEnabled", state.contextEnabled);
            setCheck("navPrecise", state.navPrecise);
            setRadio("callerLimit", String(state.callerLimit));
            setCheck("includeTests", state.includeTests);
            setCheck("eventsEnabled", state.eventsEnabled);
            setRadio("detailFileLimit", String(state.detailFileLimit));
            setRadio("snippetMaxLines", String(state.snippetMaxLines));
            setCheck("outsideCallers", state.outsideCallers);
            setRadio("grepMaxColumns", String(state.grepMaxColumns));
            setCheck("includeSeen", state.includeSeen);
            setCheck("redactEnabled", state.redactEnabled);
            for (const ent of ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN", "CREDIT_CARD"]) {
                setCheck(`pii_${ent}`, state.piiEntities.includes(ent));
            }
            setCheck("sensWebhook", state.sensWebhook);
            setCheck("customRule", state.customRule);
            setCheck("jevEnabled", state.jevEnabled);
            for (const sc of ["search", "read", "grep"]) {
                setCheck(`jev_${sc}`, state.jevScope.includes(sc));
            }
            const modelSel = form.elements.namedItem("jevModel") as HTMLSelectElement | null;
            if (modelSel) modelSel.value = state.jevModel;
            setRadio("indexMode", state.indexMode);
            setCheck("storeRefs", state.storeRefs);
            setRadio("exclDirs", state.exclDirs);
            setCheck("docSupport", state.docSupport);
            setRadio("fsPerm", state.fsPerm);
            setCheck("synonymsEnabled", state.synonymsEnabled);
            setCheck("globalInst", state.globalInst);
        }

        private wireControls() {
            const form = this.querySelector<HTMLFormElement>("[data-pg-form]");
            form?.addEventListener("input", () => {
                this.clearActivePreset();
                this.render();
            });
            form?.addEventListener("change", () => {
                this.clearActivePreset();
                this.render();
            });
            form?.addEventListener("submit", (e) => e.preventDefault());

            // Presets
            const presetBtns = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-preset]"));
            for (const btn of presetBtns) {
                btn.addEventListener("click", () => {
                    const key = btn.dataset.preset ?? "default";
                    const next: PgState = {
                        ...DEFAULT_STATE,
                        piiEntities: [...DEFAULT_STATE.piiEntities],
                        jevScope: [...DEFAULT_STATE.jevScope],
                        ...(PRESETS[key] ?? {}),
                    };
                    this.applyStateToForm(next);
                    for (const b of presetBtns) b.classList.toggle("is-active", b === btn);
                    this.render();
                });
            }

            // Reset
            this.querySelector<HTMLButtonElement>("[data-reset]")?.addEventListener("click", () => {
                this.applyStateToForm({
                    ...DEFAULT_STATE,
                    piiEntities: [],
                    jevScope: ["search", "read", "grep"],
                });
                for (const b of presetBtns) b.classList.toggle("is-active", b.dataset.preset === "default");
                this.render();
            });

            // Category filter tabs
            const catBtns = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-cat-btn]"));
            const selectCat = (btn: HTMLButtonElement, focus: boolean) => {
                this.selectedCat = btn.dataset.catBtn ?? "all";
                for (const b of catBtns) {
                    const on = b === btn;
                    b.setAttribute("aria-selected", String(on));
                    b.tabIndex = on ? 0 : -1;
                }
                if (focus) btn.focus();
                this.applySettingFilters();
            };
            for (const b of catBtns) {
                b.addEventListener("click", () => selectCat(b, false));
                b.addEventListener("keydown", (e) => {
                    const idx = catBtns.indexOf(b);
                    if (e.key === "ArrowRight") {
                        e.preventDefault();
                        selectCat(catBtns[(idx + 1) % catBtns.length], true);
                    } else if (e.key === "ArrowLeft") {
                        e.preventDefault();
                        selectCat(catBtns[(idx - 1 + catBtns.length) % catBtns.length], true);
                    }
                });
            }

            // Key search filter
            const searchInput = this.querySelector<HTMLInputElement>("[data-key-filter]");
            searchInput?.addEventListener("input", () => {
                this.filterQuery = searchInput.value.trim().toLowerCase();
                this.applySettingFilters();
            });

            // TOML mode
            const modeBtns = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-toml-mode]"));
            for (const btn of modeBtns) {
                btn.addEventListener("click", () => {
                    this.tomlMode = (btn.dataset.tomlMode as "diff" | "full") ?? "diff";
                    for (const b of modeBtns) b.setAttribute("aria-pressed", String(b === btn));
                    this.render();
                });
            }

            // Output vs Diff mode
            const viewBtns = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-view-mode]"));
            for (const btn of viewBtns) {
                btn.addEventListener("click", () => {
                    this.viewMode = (btn.dataset.viewMode as "output" | "diff") ?? "output";
                    for (const b of viewBtns) b.setAttribute("aria-pressed", String(b === btn));
                    this.render();
                });
            }

            // Changed tools only pill
            const changedPill = this.querySelector<HTMLButtonElement>("[data-changed-only]");
            changedPill?.addEventListener("click", () => {
                this.changedToolsOnly = !this.changedToolsOnly;
                changedPill.setAttribute("aria-pressed", String(this.changedToolsOnly));
                this.render();
            });

            // Tool tabs
            const tabs = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-tool-tab]"));
            const selectTab = (targetBtn: HTMLButtonElement, moveFocus: boolean) => {
                this.selectedTab = targetBtn.dataset.toolTab ?? "all";
                for (const t of tabs) {
                    const active = t === targetBtn;
                    t.setAttribute("aria-selected", String(active));
                    t.tabIndex = active ? 0 : -1;
                }
                if (moveFocus) {
                    targetBtn.focus();
                    targetBtn.scrollIntoView({ block: "nearest", inline: "nearest" });
                }
                this.render();
            };

            for (const tab of tabs) {
                tab.addEventListener("click", () => selectTab(tab, false));
                tab.addEventListener("keydown", (e) => {
                    const idx = tabs.indexOf(tab);
                    if (e.key === "ArrowRight") {
                        e.preventDefault();
                        selectTab(tabs[(idx + 1) % tabs.length], true);
                    } else if (e.key === "ArrowLeft") {
                        e.preventDefault();
                        selectTab(tabs[(idx - 1 + tabs.length) % tabs.length], true);
                    } else if (e.key === "Home") {
                        e.preventDefault();
                        selectTab(tabs[0], true);
                    } else if (e.key === "End") {
                        e.preventDefault();
                        selectTab(tabs[tabs.length - 1], true);
                    }
                });
            }
        }

        private applySettingFilters() {
            const groups = Array.from(this.querySelectorAll<HTMLElement>("[data-cat-group]"));
            let anyVisible = false;

            for (const grp of groups) {
                const cat = grp.dataset.catGroup ?? "";
                const catMatch = this.selectedCat === "all" || this.selectedCat === cat;
                const rows = Array.from(grp.querySelectorAll<HTMLElement>(".wb-row"));
                let groupVisible = 0;

                for (const r of rows) {
                    const hay = `${r.dataset.keywords ?? ""} ${r.textContent ?? ""}`.toLowerCase();
                    const qMatch = !this.filterQuery || hay.includes(this.filterQuery);
                    const show = catMatch && qMatch;
                    r.hidden = !show;
                    if (show) groupVisible++;
                }

                grp.hidden = groupVisible === 0;
                if (groupVisible > 0) anyVisible = true;
            }

            const emptyEl = this.querySelector<HTMLElement>("[data-empty-filter]");
            if (emptyEl) emptyEl.hidden = anyVisible;
        }

        private clearActivePreset() {
            for (const b of Array.from(this.querySelectorAll<HTMLButtonElement>("[data-preset]"))) {
                b.classList.remove("is-active");
            }
        }

        private wireCopyButtons() {
            const btns = Array.from(this.querySelectorAll<HTMLButtonElement>(".pg-copy-btn"));
            const codeEl = this.querySelector<HTMLElement>("[data-toml-out]");
            if (btns.length === 0 || !codeEl) return;

            const doCopy = async (btn: HTMLButtonElement) => {
                const text = (codeEl.innerText || codeEl.textContent || "").trim();
                if (!text) return;
                let ok = true;
                try {
                    await navigator.clipboard.writeText(text);
                } catch {
                    ok = false;
                }
                this.reportCopy(btn, ok);
            };

            if ("CommandEvent" in window) {
                document.addEventListener(
                    "command",
                    (event: Event) => {
                        const ce = event as Event & { command?: string; source?: Element };
                        if (ce.command === "--copy" && ce.source instanceof HTMLButtonElement && btns.includes(ce.source)) {
                            void doCopy(ce.source);
                        }
                    },
                    true,
                );
            } else {
                for (const btn of btns) {
                    btn.addEventListener("click", () => {
                        void doCopy(btn);
                    });
                }
            }
        }

        private reportCopy(button: HTMLButtonElement, ok: boolean) {
            const tip = button.nextElementSibling as HTMLElement | null;
            if (!tip) return;
            const prevTimer = copyTimers.get(button);
            if (prevTimer) window.clearTimeout(prevTimer);

            button.removeAttribute("data-copied");
            button.removeAttribute("data-failed");
            let message = ok ? (this.ui.copiedMsg ?? "Copied") : (this.ui.copyFailedMsg ?? "Copy failed");
            if (message === lastStatusText) message += "\u00A0";
            lastStatusText = message;

            tip.textContent = "";
            void button.offsetWidth;
            button.setAttribute(ok ? "data-copied" : "data-failed", "");
            requestAnimationFrame(() => {
                tip.textContent = message;
            });
            const timer = window.setTimeout(() => {
                button.removeAttribute("data-copied");
                button.removeAttribute("data-failed");
                tip.textContent = "";
            }, 2000);
            copyTimers.set(button, timer);
        }

        private buildToml(s: PgState): { lines: string[]; modifiedKeys: Set<string> } {
            const full = this.tomlMode === "full";
            const sections: Array<[string, string[]]> = [];
            const mod = new Set<string>();

            const push = (sec: string, lns: string[]) => {
                if (lns.length > 0) sections.push([sec, lns]);
            };

            if (s.globalInst !== DEFAULT_STATE.globalInst) mod.add("globalInst");
            if (full || s.globalInst !== DEFAULT_STATE.globalInst) {
                const note =
                    this.locale === "ko"
                        ? " # 전역 ~/.codemap/config.toml 전용"
                        : " # global ~/.codemap/config.toml only";
                push("[global_instructions]", [`enabled = ${s.globalInst}${note}`]);
            }

            if (s.redactEnabled !== DEFAULT_STATE.redactEnabled) mod.add("redactEnabled");
            if (full || s.redactEnabled !== DEFAULT_STATE.redactEnabled) {
                push("[output]", [`is_redact_enabled = ${s.redactEnabled}`]);
            }

            const searchLines: string[] = [];
            if (s.detailFileLimit !== DEFAULT_STATE.detailFileLimit) mod.add("detailFileLimit");
            if (full || s.detailFileLimit !== DEFAULT_STATE.detailFileLimit) {
                searchLines.push(`detail_file_limit = ${s.detailFileLimit}`);
            }
            if (s.snippetMaxLines !== DEFAULT_STATE.snippetMaxLines) mod.add("snippetMaxLines");
            if (full || s.snippetMaxLines !== DEFAULT_STATE.snippetMaxLines) {
                searchLines.push(`snippet_max_lines = ${s.snippetMaxLines}`);
            }
            push("[output.search]", searchLines);

            if (s.outsideCallers !== DEFAULT_STATE.outsideCallers) mod.add("outsideCallers");
            if (full || s.outsideCallers !== DEFAULT_STATE.outsideCallers) {
                push("[output.read]", [`is_outside_callers_enabled = ${s.outsideCallers}`]);
            }

            if (s.grepMaxColumns !== DEFAULT_STATE.grepMaxColumns) mod.add("grepMaxColumns");
            if (full || s.grepMaxColumns !== DEFAULT_STATE.grepMaxColumns) {
                push("[output.grep]", [`max_columns = ${s.grepMaxColumns}`]);
            }

            const ctxLines: string[] = [];
            if (s.contextEnabled !== DEFAULT_STATE.contextEnabled) mod.add("contextEnabled");
            if (full || s.contextEnabled !== DEFAULT_STATE.contextEnabled) {
                ctxLines.push(`is_enabled = ${s.contextEnabled}`);
            }
            if (s.callerLimit !== DEFAULT_STATE.callerLimit) mod.add("callerLimit");
            if (full || s.callerLimit !== DEFAULT_STATE.callerLimit) {
                ctxLines.push(`caller_limit = ${s.callerLimit}`);
            }
            push("[output.context]", ctxLines);

            if (s.includeTests !== DEFAULT_STATE.includeTests) mod.add("includeTests");
            if (full || s.includeTests !== DEFAULT_STATE.includeTests) {
                push("[output.context.exclude]", [`should_include_test_code = ${s.includeTests}`]);
            }

            if (s.navPrecise !== DEFAULT_STATE.navPrecise) mod.add("navPrecise");
            if (full || s.navPrecise !== DEFAULT_STATE.navPrecise) {
                push("[output.navigation]", [`is_enabled = ${s.navPrecise}`]);
            }

            if (s.eventsEnabled !== DEFAULT_STATE.eventsEnabled) mod.add("eventsEnabled");
