            };
            if (s.includeSeen) readCallObj.include_seen = true;
            const readCall = JSON.stringify({ name: "read", arguments: readCallObj });

            const readLines: string[] = [
                `[Permission policy: ${s.fsPerm}${s.fsPerm === "allowed_roots" ? " (workspace + ../grafana-plugins)" : ""}]`,
