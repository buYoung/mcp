---
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const { locale } = Astro.locals.starlightRoute;
const isKo = locale === "ko";
const pgHref = isKo ? "/ko/playground/" : "/playground/";
const pgLabel = isKo ? "플레이그라운드" : "Playground";
const pathname = Astro.url.pathname.replace(/\/+$/, "");
const isPlayground = pathname === "/playground" || pathname === "/ko/playground";
---

<a
    href={pgHref}
    class="sl-header-playground"
    aria-current={isPlayground ? "page" : undefined}
>
    <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path
            d="M2 4h7M12 4h2M9 2.5v3M2 8h3M8 8h6M5 6.5v3M2 12h8M13 12h1M10 10.5v3"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
        />
    </svg>
    <span>{pgLabel}</span>
</a>
<Default><slot /></Default>
