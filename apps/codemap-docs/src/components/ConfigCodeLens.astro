---
interface Props {
    locale: "en" | "ko";
}

const { locale } = Astro.props;
const isKo = locale === "ko";

const labels = {
    close: isKo ? "닫기 (Esc)" : "Close (Esc)",
    jumpSection: isKo ? "아래 상세 열기 ↘" : "Jump to section ↘",
    openPage: isKo ? "전체 문서 열기 ↗" : "Open full page ↗",
    piiTitle: isKo ? "내장 PII 마스킹 유형 (90종)" : "Built-in PII Redaction Types (90)",
    piiIntro: isKo
        ? "`[output.redact].pii_entities` 배열에 필요한 유형 문자열을 넣어 활성화합니다. 기본값 `[]`에서는 인증정보만 마스킹합니다."
        : "Add type names to `[output.redact].pii_entities` to mask them. With the default `[]`, only credentials are masked.",
};

const piiGroups = [
    {
        scope: isKo ? "국제 공통 (9)" : "International (9)",
        items: "CREDIT_CARD, CRYPTO, DATE_TIME, EMAIL_ADDRESS, IBAN_CODE, IP_ADDRESS, MAC_ADDRESS, URL, UUID",
    },
    {
        scope: isKo ? "한국 (5)" : "Korea (5)",
        items: "KR_BRN, KR_DRIVER_LICENSE, KR_FRN, KR_PASSPORT, KR_RRN",
    },
    {
        scope: isKo ? "미국 (15)" : "United States (15)",
        items: "ABA_ROUTING_NUMBER, MEDICAL_LICENSE, US_BANK_NUMBER, US_DRIVER_LICENSE, US_HEALTH_INSURANCE_MEMBER_ID, US_PRIOR_AUTHORIZATION_NUMBER, US_CLAIM_NUMBER, US_PRESCRIPTION_NUMBER, US_REFERRAL_NUMBER, US_PROVIDER_TAX_ID, US_ITIN, US_MBI, US_NPI, US_PASSPORT, US_SSN",
    },
    {
        scope: isKo ? "유럽·영국 (35)" : "Europe & UK (35)",
        items: "DE_BSNR, DE_FUEHRERSCHEIN, DE_HANDELSREGISTER, DE_HEALTH_INSURANCE, DE_ID_CARD, DE_KFZ, DE_LANR, DE_PASSPORT, DE_PLZ, DE_SOCIAL_SECURITY, DE_TAX_ID, DE_TAX_NUMBER, DE_VAT_ID, ES_NIE, ES_NIF, ES_PASSPORT, FI_PERSONAL_IDENTITY_CODE, IT_DRIVER_LICENSE, IT_FISCAL_CODE, IT_IDENTITY_CARD, IT_PASSPORT, IT_VAT_CODE, PL_PESEL, SE_ORGANISATIONSNUMMER, SE_PERSONNUMMER, TR_LICENSE_PLATE, TR_NATIONAL_ID, UK_DRIVING_LICENCE, UK_NHS, UK_NINO, UK_PASSPORT, UK_POSTCODE, UK_VEHICLE_REGISTRATION",
    },
    {
        scope: isKo ? "아시아·오세아니아·기타 (26)" : "APAC, Americas & Africa (26)",
        items: "AU_ABN, AU_ACN, AU_MEDICARE, AU_TFN, CA_POSTAL_CODE, CA_SIN, IN_AADHAAR, IN_GSTIN, IN_PAN, IN_PASSPORT, IN_VEHICLE_REGISTRATION, IN_VOTER, NG_NIN, NG_VEHICLE_REGISTRATION, PH_PASSPORT, PH_TIN, PH_UMID, SG_NRIC_FIN, SG_UEN, TH_TNIN, ZA_COMPANY_REGISTRATION, ZA_DRIVER_LICENSE, ZA_ID_NUMBER, ZA_INCOME_TAX_NUMBER, ZA_LICENSE_PLATE, ZA_PASSPORT, ZA_TRAFFIC_REGISTER_NUMBER, ZA_VAT_NUMBER",
    },
];

const piiHref = isKo ? "/ko/configuration/pii-redaction/" : "/configuration/pii-redaction/";
---

<codemap-config-peek
    class="not-content"
    data-close-label={labels.close}
    data-jump-label={labels.jumpSection}
    data-open-page-label={labels.openPage}
    data-pii-title={labels.piiTitle}
    data-pii-href={piiHref}
>
    <template data-pii-template>
        <p class="codemap-peek-lead">{labels.piiIntro}</p>
        <pre class="codemap-peek-pre"><code>[output.redact]
pii_entities = ["EMAIL_ADDRESS", "IP_ADDRESS", "KR_RRN"]</code></pre>
        <div class="codemap-peek-pii-grid">
            {
                piiGroups.map((g) => (
                    <div class="codemap-peek-pii-card">
                        <strong>{g.scope}</strong>
                        <p>
                            <code>{g.items}</code>
                        </p>
                    </div>
                ))
            }
        </div>
    </template>
</codemap-config-peek>

<script>
    class CodemapConfigPeek extends HTMLElement {
        private activeBtn: HTMLButtonElement | null = null;
        private activePeekRow: HTMLElement | null = null;

        connectedCallback() {
            const container = this.closest(".sl-markdown-content");
            if (!container) return;

            // Open matching <details> automatically on URL hash arrival or change
            const openHashDetails = () => {
                if (!window.location.hash) return;
                const id = decodeURIComponent(window.location.hash.slice(1));
                const target = container.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
                const details = target?.closest("details");
                if (details) details.open = true;
            };
            openHashDetails();
            window.addEventListener("hashchange", openHashDetails);

            const closeLabel = this.dataset.closeLabel ?? "Close (Esc)";
            const jumpLabel = this.dataset.jumpLabel ?? "Jump to section";
            const openPageLabel = this.dataset.openPageLabel ?? "Open full page";
            const piiTitle = this.dataset.piiTitle ?? "PII Redaction";
            const piiHref = this.dataset.piiHref ?? "/configuration/pii-redaction/";
            const piiTemplate = this.querySelector<HTMLTemplateElement>("[data-pii-template]");

            // Enhance reference links inside all 5-column Key Reference tables
            const keyTables = Array.from(container.querySelectorAll("table")).filter(
                (tbl) => tbl.querySelectorAll("thead th").length === 5,
            );

            for (const keyTable of keyTables) {
                keyTable.classList.add("cfg-key-table");
                const links = Array.from(keyTable.querySelectorAll<HTMLAnchorElement>("tbody a[href]"));
                for (const link of links) {
                    const href = link.getAttribute("href") ?? "";
                    const isHash = href.startsWith("#") && href.length > 1;
                    const isPiiPage = href.includes("/configuration/pii-redaction");
                    if (!isHash && !isPiiPage) continue;

                    const labelText = (link.textContent ?? "").trim();
                    if (!labelText) continue;

                    const btn = document.createElement("button");
                    btn.type = "button";
                    btn.className = "codemap-lens-btn";
                    btn.setAttribute("aria-expanded", "false");
                    btn.dataset.peekHref = href;
                    btn.dataset.peekKind = isHash ? "section" : "pii";

                    const icon = document.createElement("span");
                    icon.className = "codemap-lens-chevron";
                    icon.setAttribute("aria-hidden", "true");
                    icon.textContent = "▸";

                    const textSpan = document.createElement("span");
                    textSpan.textContent = labelText;

                    btn.append(icon, textSpan);
                    link.replaceWith(btn);

                    btn.addEventListener("click", () => {
                        if (this.activeBtn === btn) {
                            this.closePeek(false);
                            return;
                        }
                        this.openPeek(btn, container, {
                            closeLabel,
                            jumpLabel,
                            openPageLabel,
                            piiTitle,
                            piiHref,
                            piiTemplate,
                        });
                    });
                }
            }

            document.addEventListener("keydown", (event) => {
                if (event.key === "Escape" && this.activeBtn) {
                    event.preventDefault();
                    this.closePeek(true);
                }
            });
        }

        private stripIds(root: ParentNode) {
            for (const el of Array.from(root.querySelectorAll("[id]"))) {
                el.removeAttribute("id");
            }
        }

        private extractTargetNodes(
            container: Element,
            hash: string,
        ): { title: string; frag: DocumentFragment } | null {
            const rawId = decodeURIComponent(hash.slice(1));
            const target = container.querySelector<HTMLElement>(`#${CSS.escape(rawId)}`);
            if (!target) return null;

            const frag = document.createDocumentFragment();

            // Case 1: <details id="..."> disclosure block
            if (target instanceof HTMLDetailsElement) {
                const summary = target.querySelector(":scope > summary");
                const title = (summary?.textContent ?? rawId).trim();
                for (const child of Array.from(target.children)) {
                    if (child === summary) continue;
                    const clone = child.cloneNode(true) as HTMLElement;
                    this.stripIds(clone);
                    frag.append(clone);
                }
                return { title, frag };
            }

            // Case 2: nested block inside a <details> (e.g. #openrouter-판정-모델)
            if (target.hasAttribute("data-peek-block")) {
                const title = target.getAttribute("data-peek-title") ?? rawId;
                const clone = target.cloneNode(true) as HTMLElement;
                clone.removeAttribute("id");
                this.stripIds(clone);
                frag.append(clone);
                return { title, frag };
            }

            // Case 3: standard heading section
            const headingWrapper = target.closest(".sl-heading-wrapper") ?? target;
            const tagMatch = /^H([1-6])$/.exec(target.tagName);
            const baseLevel = tagMatch ? Number(tagMatch[1]) : 3;
            const title = (target.textContent ?? "").trim();

            let cursor = headingWrapper.nextElementSibling;
            while (cursor) {
                const innerHeading = cursor.matches("h1, h2, h3, h4, h5, h6")
                    ? cursor
                    : cursor.querySelector(
                          ":scope > h1, :scope > h2, :scope > h3, :scope > h4, :scope > h5, :scope > h6",
                      );
                if (innerHeading) {
                    const m = /^H([1-6])$/.exec(innerHeading.tagName);
                    const nextLevel = m ? Number(m[1]) : 6;
                    if (nextLevel <= baseLevel) break;
                }
                const clone = cursor.cloneNode(true) as HTMLElement;
                this.stripIds(clone);
                frag.append(clone);
                cursor = cursor.nextElementSibling;
            }
            return { title, frag };
        }

        private openPeek(
            btn: HTMLButtonElement,
            container: Element,
            opts: {
                closeLabel: string;
                jumpLabel: string;
                openPageLabel: string;
                piiTitle: string;
                piiHref: string;
                piiTemplate: HTMLTemplateElement | null;
            },
        ) {
            this.closePeek(false);

            const row = btn.closest("tr");
            if (!row) return;

            const href = btn.dataset.peekHref ?? "";
            const kind = btn.dataset.peekKind ?? "section";

            let title = "";
            const bodyFrag = document.createDocumentFragment();

            if (kind === "pii" && opts.piiTemplate) {
                title = opts.piiTitle;
                bodyFrag.append(opts.piiTemplate.content.cloneNode(true));
            } else {
                const extracted = this.extractTargetNodes(container, href);
                if (!extracted) return;
                title = extracted.title;
                bodyFrag.append(extracted.frag);
            }

            const colCount = row.children.length || 5;
            const peekTr = document.createElement("tr");
            peekTr.className = "codemap-peek-row";

            const td = document.createElement("td");
            td.colSpan = colCount;
            td.className = "codemap-peek-cell";

            const panel = document.createElement("div");
            panel.className = "codemap-peek-panel";

            const bar = document.createElement("div");
            bar.className = "codemap-peek-bar";

            const titleEl = document.createElement("span");
            titleEl.className = "codemap-peek-title";
            titleEl.textContent = title;

            const actions = document.createElement("div");
            actions.className = "codemap-peek-actions";

            const navLink = document.createElement("a");
            navLink.className = "codemap-peek-link";
            navLink.href = kind === "pii" ? opts.piiHref : href;
            navLink.textContent = kind === "pii" ? opts.openPageLabel : opts.jumpLabel;
            if (kind !== "pii") {
                navLink.addEventListener("click", () => {
                    const id = decodeURIComponent(href.slice(1));
                    const target = container.querySelector<HTMLElement>(`#${CSS.escape(id)}`);
                    const details = target?.closest("details");
                    if (details) details.open = true;
                    this.closePeek(false);
                });
            }

            const closeBtn = document.createElement("button");
            closeBtn.type = "button";
            closeBtn.className = "codemap-peek-close";
            closeBtn.textContent = opts.closeLabel;
            closeBtn.addEventListener("click", () => {
                this.closePeek(true);
            });

            actions.append(navLink, closeBtn);
            bar.append(titleEl, actions);

            const body = document.createElement("div");
            body.className = "codemap-peek-body";
            body.append(bodyFrag);

            panel.append(bar, body);
            td.append(panel);
            peekTr.append(td);

            row.classList.add("has-open-peek");
            row.after(peekTr);

            btn.setAttribute("aria-expanded", "true");
            this.activeBtn = btn;
            this.activePeekRow = peekTr;
        }

        private closePeek(restoreFocus: boolean) {
            const prevBtn = this.activeBtn;
            if (prevBtn) {
                prevBtn.setAttribute("aria-expanded", "false");
                prevBtn.closest("tr")?.classList.remove("has-open-peek");
            }
            if (this.activePeekRow) {
                this.activePeekRow.remove();
            }
            this.activeBtn = null;
            this.activePeekRow = null;
            if (restoreFocus && prevBtn) {
                prevBtn.focus();
            }
        }
    }

    if (!customElements.get("codemap-config-peek")) {
        customElements.define("codemap-config-peek", CodemapConfigPeek);
    }
</script>
