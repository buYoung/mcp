---
interface Props {
    locale: "en" | "ko";
}

const { locale } = Astro.props;
const isKo = locale === "ko";

const envs = ["pi direct", "pi codemode", "Codex code mode"];

const series = [
    {
        id: "codemap-search",
        label: "codemap-search",
        color: "var(--sl-color-text-accent)",
        dash: "",
        width: 2.75,
        primary: true,
        acc: [88.9, 89.8, 90.7],
        accDetail: ["88.9% (96/108)", "89.8% (97/108)", "90.7% (98/108)"],
        tok: [946, 829, 1333],
        tokDetail: isKo
            ? ["946k (비캐시 98k)", "829k (비캐시 101k)", "1,333k (비캐시 133k)"]
            : ["946k (uncached 98k)", "829k (uncached 101k)", "1,333k (uncached 133k)"],
    },
    {
        id: "graphify",
        label: "Graphify",
        color: "#0ea5e9",
        dash: "",
        width: 2,
        primary: false,
        acc: [86.1, 81.5, 87.0],
        accDetail: ["86.1% (93/108)", "81.5% (88/108)", "87.0% (94/108)"],
        tok: [1008, 746, 1183],
        tokDetail: isKo
            ? ["1,008k (비캐시 93k)", "746k (비캐시 93k)", "1,183k (비캐시 108k)"]
            : ["1,008k (uncached 93k)", "746k (uncached 93k)", "1,183k (uncached 108k)"],
    },
    {
        id: "zvec-grep",
        label: "zvec-grep",
        color: "#f59e0b",
        dash: "6 3",
        width: 2,
        primary: false,
        acc: [82.4, 84.5, 80.6],
        accDetail: ["82.4% (89/108)", "84.5%* (71/84)", "80.6% (87/108)"],
        tok: [784, 608, 869],
        tokDetail: isKo
            ? ["784k (비캐시 77k)", "608k* (비캐시 79k)", "869k (비캐시 96k)"]
            : ["784k (uncached 77k)", "608k* (uncached 79k)", "869k (uncached 96k)"],
    },
    {
        id: "rg",
        label: isKo ? "rg (기준군)" : "rg (baseline)",
        color: "#10b981",
        dash: "3 3",
        width: 2,
        primary: false,
        acc: [79.6, 80.6, 82.4],
        accDetail: ["79.6% (86/108)", "80.6% (87/108)", "82.4% (89/108)"],
        tok: [555, 505, 866],
        tokDetail: isKo
            ? ["555k (비캐시 68k)", "505k (비캐시 76k)", "866k (비캐시 104k)"]
            : ["555k (uncached 68k)", "505k (uncached 76k)", "866k (uncached 104k)"],
    },
    {
        id: "codebase-memory",
        label: "codebase-memory",
        color: "#8b5cf6",
        dash: "",
        width: 2,
        primary: false,
        acc: [80.6, 77.8, 78.7],
        accDetail: ["80.6% (87/108)", "77.8% (84/108)", "78.7% (85/108)"],
        tok: [1331, 1190, 1827],
        tokDetail: isKo
            ? ["1,331k (비캐시 89k)", "1,190k (비캐시 113k)", "1,827k (비캐시 144k)"]
            : ["1,331k (uncached 89k)", "1,190k (uncached 113k)", "1,827k (uncached 144k)"],
    },
    {
        id: "codegraph",
        label: "CodeGraph",
        color: "#ef4444",
        dash: "8 3",
        width: 2,
        primary: false,
        acc: [72.2, 78.7, 79.6],
        accDetail: ["72.2% (78/108)", "78.7% (85/108)", "79.6% (86/108)"],
        tok: [1727, 1724, 3309],
        tokDetail: isKo
            ? ["1,727k (비캐시 132k)", "1,724k (비캐시 142k)", "3,309k (비캐시 194k)"]
            : ["1,727k (uncached 132k)", "1,724k (uncached 142k)", "3,309k (uncached 194k)"],
    },
];

const svgW = 460;
const svgH = 260;
const padLeft = 52;
const padRight = 32;
const padTop = 16;
const padBottom = 34;
const plotW = svgW - padLeft - padRight;
const plotH = svgH - padTop - padBottom;
const xCoords = [padLeft + 18, padLeft + plotW / 2, padLeft + plotW - 18];

function yPos(val: number, minV: number, maxV: number): number {
    return padTop + plotH - ((val - minV) / (maxV - minV)) * plotH;
}

const accTicks = [70, 75, 80, 85, 90, 95];
const tokTicks = [0, 1000, 2000, 3000, 3500];

const titleAcc = isKo ? "정답 충족률 (%)" : "Fulfilled rate (%)";
const titleTok = isKo ? "답변당 평균 총 토큰 (k)" : "Mean total tokens / answer (k)";

const payload = JSON.stringify({
    envs,
    series,
    xCoords,
    padTop,
    plotH,
    padLeft,
    svgW,
});
---

<codemap-line-chart class="bench-line-widget not-content" data-chart={payload}>
    <div class="bench-series-bar" role="group" aria-label={isKo ? "비교 도구 표시 전환" : "Toggle tool series"}>
        {
            series.map((s) => (
                <button
                    type="button"
                    class:list={["bench-series-btn", { "is-primary": s.primary }]}
                    data-series-btn={s.id}
                    aria-pressed="true"
                >
                    <svg class="bench-series-sample" viewBox="0 0 22 10" aria-hidden="true">
                        <line
                            x1="1"
                            y1="5"
                            x2="21"
                            y2="5"
                            stroke={s.color}
                            stroke-width={s.width}
                            stroke-dasharray={s.dash || undefined}
                        />
                        <circle cx="11" cy="5" r="2.8" fill={s.color} />
                    </svg>
                    <span>{s.label}</span>
                </button>
            ))
        }
    </div>

    <div class="bench-charts">
        <div class="bench-chart-card" data-chart-panel="acc">
            <p class="bench-chart-title">{titleAcc}</p>
            <div class="bench-svg-stage">
                <svg class="bench-chart-svg" viewBox={`0 0 ${svgW} ${svgH}`} aria-hidden="true">
                    <g data-grid-group="acc">
                        {
                            accTicks.map((t, idx) => {
                                const y = yPos(t, 70, 95);
                                return (
                                    <g>
                                        <line
                                            class={idx === 0 ? "axis-line" : "grid-line"}
                                            x1={padLeft}
                                            y1={y.toFixed(1)}
                                            x2={svgW - padRight}
                                            y2={y.toFixed(1)}
                                        />
                                        <text class="axis-label" x={padLeft - 8} y={(y + 3.5).toFixed(1)} text-anchor="end">
                                            {`${t}%`}
                                        </text>
                                    </g>
                                );
                            })
                        }
                    </g>
                    {
                        envs.map((env, ei) => (
                            <text
                                class="axis-label env-label"
                                x={xCoords[ei].toFixed(1)}
                                y={svgH - 10}
                                text-anchor="middle"
                            >
                                {env}
                            </text>
                        ))
                    }
                    <line
                        class="hover-guide"
                        data-hover-line
                        x1={xCoords[0]}
                        y1={padTop}
                        x2={xCoords[0]}
                        y2={padTop + plotH}
                    />
                    <g data-lines-group="acc">
                        {
                            series.map((s) => {
                                const pts = s.acc.map((v, i) => `${xCoords[i].toFixed(1)},${yPos(v, 70, 95).toFixed(1)}`).join(" ");
                                return (
                                    <g class="series-group" data-series-id={s.id}>
                                        <polyline
                                            class="series-line"
                                            points={pts}
                                            fill="none"
                                            stroke={s.color}
                                            stroke-width={s.width}
                                            stroke-dasharray={s.dash || undefined}
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                        {s.acc.map((v, ei) => (
                                            <circle
                                                class="series-point"
                                                data-env-idx={ei}
                                                cx={xCoords[ei].toFixed(1)}
                                                cy={yPos(v, 70, 95).toFixed(1)}
                                                r={s.primary ? "4.2" : "3.4"}
                                                fill={s.color}
                                            />
                                        ))}
                                    </g>
                                );
                            })
                        }
                    </g>
                </svg>
                <div class="env-hit-grid">
                    {
                        envs.map((env, ei) => (
                            <button
                                type="button"
                                class="env-hit-btn"
                                data-env-band={ei}
                                aria-label={`${titleAcc}: ${env}`}
                            />
                        ))
                    }
                </div>
                <div class="bench-tooltip" data-tooltip hidden></div>
            </div>
        </div>

        <div class="bench-chart-card" data-chart-panel="tok">
            <p class="bench-chart-title">{titleTok}</p>
            <div class="bench-svg-stage">
                <svg class="bench-chart-svg" viewBox={`0 0 ${svgW} ${svgH}`} aria-hidden="true">
                    <g data-grid-group="tok">
                        {
                            tokTicks.map((t, idx) => {
                                const y = yPos(t, 0, 3500);
                                const lbl = t === 0 ? "0" : `${t.toLocaleString("en-US")}k`;
                                return (
                                    <g>
                                        <line
                                            class={idx === 0 ? "axis-line" : "grid-line"}
                                            x1={padLeft}
                                            y1={y.toFixed(1)}
                                            x2={svgW - padRight}
                                            y2={y.toFixed(1)}
                                        />
                                        <text class="axis-label" x={padLeft - 8} y={(y + 3.5).toFixed(1)} text-anchor="end">
                                            {lbl}
                                        </text>
                                    </g>
                                );
                            })
                        }
                    </g>
                    {
                        envs.map((env, ei) => (
                            <text
                                class="axis-label env-label"
                                x={xCoords[ei].toFixed(1)}
                                y={svgH - 10}
                                text-anchor="middle"
                            >
                                {env}
                            </text>
                        ))
                    }
                    <line
                        class="hover-guide"
                        data-hover-line
                        x1={xCoords[0]}
                        y1={padTop}
                        x2={xCoords[0]}
                        y2={padTop + plotH}
                    />
                    <g data-lines-group="tok">
                        {
                            series.map((s) => {
                                const pts = s.tok.map((v, i) => `${xCoords[i].toFixed(1)},${yPos(v, 0, 3500).toFixed(1)}`).join(" ");
                                return (
                                    <g class="series-group" data-series-id={s.id}>
                                        <polyline
                                            class="series-line"
                                            points={pts}
                                            fill="none"
                                            stroke={s.color}
                                            stroke-width={s.width}
                                            stroke-dasharray={s.dash || undefined}
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                        />
                                        {s.tok.map((v, ei) => (
                                            <circle
                                                class="series-point"
                                                data-env-idx={ei}
                                                cx={xCoords[ei].toFixed(1)}
                                                cy={yPos(v, 0, 3500).toFixed(1)}
                                                r={s.primary ? "4.2" : "3.4"}
                                                fill={s.color}
                                            />
                                        ))}
                                    </g>
                                );
                            })
                        }
                    </g>
                </svg>
                <div class="env-hit-grid">
                    {
                        envs.map((env, ei) => (
                            <button
                                type="button"
                                class="env-hit-btn"
                                data-env-band={ei}
                                aria-label={`${titleTok}: ${env}`}
                            />
                        ))
                    }
                </div>
                <div class="bench-tooltip" data-tooltip hidden></div>
            </div>
        </div>
    </div>
</codemap-line-chart>

<script>
    interface SeriesItem {
        id: string;
        label: string;
        color: string;
        dash: string;
        width: number;
        primary: boolean;
        acc: number[];
        accDetail: string[];
        tok: number[];
        tokDetail: string[];
    }

    interface ChartPayload {
        envs: string[];
        series: SeriesItem[];
        xCoords: number[];
        padTop: number;
        plotH: number;
        padLeft: number;
        svgW: number;
    }

    class CodemapLineChart extends HTMLElement {
        #abort: AbortController | null = null;
        #hiddenSeries = new Set<string>();
        #focusSeries: string | null = null;
        #activeEnv: { panel: "acc" | "tok"; idx: number } | null = null;

        connectedCallback(): void {
            this.#abort?.abort();
            const controller = new AbortController();
            this.#abort = controller;
            const { signal } = controller;

            const raw = this.dataset.chart;
            if (!raw) return;
            const data = JSON.parse(raw) as ChartPayload;

            const buttons = Array.from(this.querySelectorAll<HTMLButtonElement>("[data-series-btn]"));
            for (const btn of buttons) {
                const id = btn.dataset.seriesBtn ?? "";
                btn.addEventListener(
                    "click",
                    () => {
                        if (this.#hiddenSeries.has(id)) {
                            this.#hiddenSeries.delete(id);
                        } else if (this.#hiddenSeries.size < data.series.length - 1) {
                            this.#hiddenSeries.add(id);
                        }
                        btn.setAttribute("aria-pressed", String(!this.#hiddenSeries.has(id)));
                        this.#syncVisibility(data);
                    },
                    { signal },
                );
                btn.addEventListener(
                    "pointerenter",
                    () => {
                        if (!this.#hiddenSeries.has(id)) {
                            this.#focusSeries = id;
                            this.#syncHighlight();
                        }
                    },
                    { signal },
                );
                btn.addEventListener(
                    "pointerleave",
                    () => {
                        this.#focusSeries = null;
                        this.#syncHighlight();
                    },
                    { signal },
                );
            }

            for (const panelName of ["acc", "tok"] as const) {
                const card = this.querySelector<HTMLElement>(`[data-chart-panel="${panelName}"]`);
                if (!card) continue;
                const bands = Array.from(card.querySelectorAll<HTMLButtonElement>("[data-env-band]"));
                for (const band of bands) {
                    const idx = Number(band.dataset.envBand ?? "0");
                    const show = () => {
                        this.#activeEnv = { panel: panelName, idx };
                        this.#renderTooltip(data, card, panelName, idx);
                    };
                    const hide = () => {
                        if (this.#activeEnv?.panel === panelName && this.#activeEnv.idx === idx) {
                            this.#activeEnv = null;
                            this.#clearTooltip(card);
                        }
                    };
                    band.addEventListener("pointerenter", show, { signal });
                    band.addEventListener("focus", show, { signal });
                    band.addEventListener("pointerleave", hide, { signal });
                    band.addEventListener("blur", hide, { signal });
                    band.addEventListener(
                        "keydown",
                        (e: KeyboardEvent) => {
                            if (e.key === "Escape") {
                                hide();
                            } else if (e.key === "ArrowRight" && idx < bands.length - 1) {
                                e.preventDefault();
                                bands[idx + 1]?.focus();
                            } else if (e.key === "ArrowLeft" && idx > 0) {
                                e.preventDefault();
                                bands[idx - 1]?.focus();
                            }
                        },
                        { signal },
                    );
                }
            }
        }

        disconnectedCallback(): void {
            this.#abort?.abort();
            this.#abort = null;
        }

        #syncHighlight(): void {
            const groups = this.querySelectorAll<SVGGElement>(".series-group");
            for (const g of groups) {
                const id = g.dataset.seriesId ?? "";
                const dimmed = this.#focusSeries !== null && this.#focusSeries !== id;
                g.classList.toggle("is-dimmed", dimmed);
                g.classList.toggle("is-focused", this.#focusSeries === id);
            }
        }

        #syncVisibility(data: ChartPayload): void {
            const visible = data.series.filter((s) => !this.#hiddenSeries.has(s.id));
            // Rescale token Y-axis dynamically to fit visible series cleanly
            const maxTokVal = Math.max(...visible.flatMap((s) => s.tok), 500);
            const tokCeil = maxTokVal <= 1500 ? 1500 : maxTokVal <= 2000 ? 2000 : 3500;
            const tokTicks =
                tokCeil === 1500
                    ? [0, 500, 1000, 1500]
                    : tokCeil === 2000
                      ? [0, 500, 1000, 1500, 2000]
                      : [0, 1000, 2000, 3000, 3500];

            const tokGrid = this.querySelector<SVGGElement>('[data-grid-group="tok"]');
            if (tokGrid) {
                const svgNS = "http://www.w3.org/2000/svg";
                tokGrid.replaceChildren();
                tokTicks.forEach((t, idx) => {
                    const y = data.padTop + data.plotH - (t / tokCeil) * data.plotH;
                    const g = document.createElementNS(svgNS, "g");
                    const line = document.createElementNS(svgNS, "line");
                    line.setAttribute("class", idx === 0 ? "axis-line" : "grid-line");
                    line.setAttribute("x1", String(data.padLeft));
                    line.setAttribute("y1", y.toFixed(1));
                    line.setAttribute("x2", String(data.svgW - 32));
                    line.setAttribute("y2", y.toFixed(1));
                    const txt = document.createElementNS(svgNS, "text");
                    txt.setAttribute("class", "axis-label");
                    txt.setAttribute("x", String(data.padLeft - 8));
                    txt.setAttribute("y", (y + 3.5).toFixed(1));
                    txt.setAttribute("text-anchor", "end");
                    txt.textContent = t === 0 ? "0" : `${t.toLocaleString("en-US")}k`;
                    g.append(line, txt);
                    tokGrid.append(g);
                });
            }

            for (const panelName of ["acc", "tok"] as const) {
                const container = this.querySelector<SVGGElement>(`[data-lines-group="${panelName}"]`);
                if (!container) continue;
                for (const s of data.series) {
                    const g = container.querySelector<SVGGElement>(`[data-series-id="${s.id}"]`);
                    if (!g) continue;
                    const isHidden = this.#hiddenSeries.has(s.id);
                    g.toggleAttribute("hidden", isHidden);
                    if (!isHidden && panelName === "tok") {
                        const poly = g.querySelector<SVGPolylineElement>("polyline");
                        const circles = g.querySelectorAll<SVGCircleElement>("circle");
                        const pts = s.tok
                            .map((v, i) => {
                                const y = data.padTop + data.plotH - (v / tokCeil) * data.plotH;
                                circles[i]?.setAttribute("cy", y.toFixed(1));
                                return `${data.xCoords[i].toFixed(1)},${y.toFixed(1)}`;
                            })
                            .join(" ");
                        poly?.setAttribute("points", pts);
                    }
                }
            }

            if (this.#activeEnv) {
                const card = this.querySelector<HTMLElement>(
                    `[data-chart-panel="${this.#activeEnv.panel}"]`,
                );
                if (card) {
                    this.#renderTooltip(data, card, this.#activeEnv.panel, this.#activeEnv.idx);
                }
            }
        }

        #renderTooltip(
            data: ChartPayload,
            card: HTMLElement,
            panelName: "acc" | "tok",
            idx: number,
        ): void {
            const line = card.querySelector<SVGLineElement>("[data-hover-line]");
            const tip = card.querySelector<HTMLElement>("[data-tooltip]");
            if (!line || !tip) return;

            const x = data.xCoords[idx];
            line.setAttribute("x1", x.toFixed(1));
            line.setAttribute("x2", x.toFixed(1));
            line.classList.add("is-visible");

            for (const pt of card.querySelectorAll<SVGCircleElement>(".series-point")) {
                pt.classList.toggle("is-active", Number(pt.dataset.envIdx) === idx);
            }

            const visible = data.series
                .filter((s) => !this.#hiddenSeries.has(s.id))
                .sort((a, b) =>
                    panelName === "acc" ? b.acc[idx] - a.acc[idx] : a.tok[idx] - b.tok[idx],
                );

            tip.replaceChildren();
            const heading = document.createElement("div");
            heading.className = "bench-tip-env";
            heading.textContent = data.envs[idx];
            tip.append(heading);

            for (const s of visible) {
                const row = document.createElement("div");
                row.className = s.primary ? "bench-tip-row is-primary" : "bench-tip-row";
                const dot = document.createElement("span");
                dot.className = "bench-tip-dot";
                dot.style.background = s.color;
                const name = document.createElement("span");
                name.className = "bench-tip-name";
                name.textContent = s.label;
                const val = document.createElement("span");
                val.className = "bench-tip-val";
                val.textContent = panelName === "acc" ? s.accDetail[idx] : s.tokDetail[idx];
                row.append(dot, name, val);
                tip.append(row);
            }

            tip.classList.toggle("align-right", idx === 2);
            tip.classList.toggle("align-center", idx === 1);
            tip.classList.toggle("align-left", idx === 0);
            tip.hidden = false;
        }

        #clearTooltip(card: HTMLElement): void {
            const line = card.querySelector<SVGLineElement>("[data-hover-line]");
            const tip = card.querySelector<HTMLElement>("[data-tooltip]");
            line?.classList.remove("is-visible");
            if (tip) tip.hidden = true;
            for (const pt of card.querySelectorAll<SVGCircleElement>(".series-point")) {
                pt.classList.remove("is-active");
            }
        }
    }

    if (!customElements.get("codemap-line-chart")) {
        customElements.define("codemap-line-chart", CodemapLineChart);
    }
</script>
