---
import "./select-field.css";
import type { SegmentOption } from "./types";

interface Props {
    id: string;
    name: string;
    options: SegmentOption[];
}

const { id, name, options } = Astro.props;
---

<div class="cm-select-wrap">
    <select id={id} name={name} class="cm-select">
        {
            options.map((opt) => (
                <option value={opt.value} selected={opt.selected}>
                    {opt.label}
                </option>
            ))
        }
    </select>
    <svg
        class="cm-select__caret"
        width="12"
        height="12"
        viewBox="0 0 12 12"
        fill="none"
        aria-hidden="true"
    >
        <path
            d="M2.5 4.5L6 8L9.5 4.5"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"></path>
    </svg>
</div>
