  "commands": {
    "build": "cargo build --release --manifest-path apps/codemap-search/experiments/related-terms-poc/Cargo.toml",
    "index": "cd <checkout> && CODEMAP_HOME=<state>/codemap-home <binary> index --state <state>",
    "verify_stats": "<binary> verify-stats --state <state>",
    "lookup": "<binary> lookup --dataset <dataset.sqlite3> --policy contracts/lookup-policy.json --state <state> [--expect-dataset-id ID] [--repeat N] [--output FILE] [--timing-output FILE] (--terms-file FILE | TERM...)",
    "drivers": [
      "python3 workspaces.py index",
      "python3 lifecycle.py run",
      "python3 lifecycle.py offline",
      "python3 lookup_handoff.py"
    ]
  },
