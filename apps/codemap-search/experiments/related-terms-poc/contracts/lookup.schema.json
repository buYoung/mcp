{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rt-lookup/1",
  "title": "Related-terms PoC lookup output (one JSON object per input term)",
  "description": "Internal experiment envelope written by `rtpoc lookup`; not a product MCP/CLI contract. Every candidate keeps its evidence and the stage/reason that kept or rejected it.",
  "type": "object",
  "required": ["schema", "input", "normalized", "dataset_id", "policy_id", "policy_sha256", "repository", "status", "matches", "candidates", "final_terms", "stage_counts", "lookup_us"],
  "properties": {
    "schema": { "const": "rt-lookup/1" },
    "input": { "type": "string", "description": "Original input spelling." },
    "normalized": {
      "type": "object",
      "required": ["exact_key", "token_key", "token_key_lossy", "index_tokens"],
      "properties": {
        "exact_key": { "type": "string" },
        "token_key": { "type": "string", "description": "rtn-2 token key (identifier split); empty for non-ASCII input." },
        "token_key_lossy": { "type": "boolean", "description": "True disables normalized matching." },
        "index_tokens": { "type": "array", "items": { "type": "string" }, "description": "Index-analyzer terms; repository statistics only." }
      }
    },
    "dataset_id": { "type": "string" },
    "policy_id": { "type": "string" },
    "policy_sha256": { "type": "string" },
    "repository": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["ready", "stale", "missing", "incompatible", "unavailable", "not_configured"] },
        "detail": { "type": ["string", "null"] },
        "published_generation": { "type": ["string", "null"], "description": "SHA-256 of the index meta.json the statistics were built from." },
        "current_generation": { "type": ["string", "null"] },
        "live_files": { "type": ["integer", "null"], "description": "Denominator: live indexed files in the published generation." },
        "vocabulary_size": { "type": ["integer", "null"] },
        "field_policy": { "type": ["string", "null"] },
        "analyzer_policy": { "type": ["string", "null"] }
      }
    },
    "status": {
      "enum": ["ok", "no_dictionary_entry", "no_relations", "repository_not_ready", "empty_after_filters"],
      "description": "no_dictionary_entry: no expression matched. no_relations: matched but no relation leaves it. repository_not_ready: statistics not ready, no final terms. empty_after_filters: candidates existed, none survived."
    },
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression_id", "exact_key", "token_key", "surfaces", "match_kind", "concepts"],
        "properties": {
          "match_kind": { "enum": ["exact", "token_normalized"] },
          "concepts": { "type": "integer", "description": "Distinct concepts (senses) the matched expression belongs to." }
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["expression_id", "exact_key", "surfaces", "token_key", "index_tokens", "primary_kind", "relation_kinds", "evidence", "repository", "outcome", "stage", "reason", "merged_into", "final_rank"],
        "properties": {
          "primary_kind": { "type": ["string", "null"], "description": "Highest-priority non-excluded relation kind." },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relation_id", "relation_kind", "evidence_kind", "source_id", "license", "matched_expression_id", "from_surface", "from_source_record", "to_surface", "to_source_record", "from_concept_id", "to_concept_id", "concept_kind", "gloss", "to_gloss", "domain_labels", "query_sense_rank", "is_policy_excluded"]
            }
          },
          "repository": {
            "type": ["object", "null"],
            "properties": {
              "components": { "type": "array", "description": "Per index-token live-file counts (null when statistics are not ready)." },
              "phrase_file_count": { "type": "null", "description": "Always null: phrase/adjacency counts are not materialized." },
              "presence": { "enum": ["present", "all_components_present", "component_absent", "unknown"] },
              "single_token_file_fraction": { "type": ["number", "null"] }
            }
          },
          "outcome": { "enum": ["final", "rejected", "not_evaluated"] },
          "stage": { "enum": ["normalization", "repository_presence", "commonness", "deduplication", "limit", "final"] },
          "reason": { "enum": [null, "excluded_relation_kind", "same_as_query", "no_index_tokens", "absent_in_repository", "too_common", "duplicate_index_tokens", "over_limit", "repository_not_ready"] },
          "merged_into": { "type": ["string", "null"] },
          "final_rank": { "type": ["integer", "null"] }
        }
      }
    },
    "final_terms": { "type": "array", "items": { "type": "string" } },
    "stage_counts": {
      "type": "object",
      "required": ["dictionary_relations", "normalized_candidates", "after_normalization", "after_repository_presence", "after_commonness", "after_deduplication", "final_candidates"]
    },
    "lookup_us": { "type": "integer", "description": "In-process wall time of this lookup only." }
  }
}
